// Recipe: Radius.Storage/objectStorage -> Azurite (Azure Storage emulator) in the cluster.
//
// Used by the local (kind) environment. Emits a connection string so the worker uses shared-key
// auth locally; the Azure Recipe instead emits only an endpoint, forcing managed identity.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Tag of the Azurite container image to deploy.')
param tag string = '3.35.0'

@description('''
Registry serving the Azurite image. Set this to a local registry, for example `myacr.azurecr.io`,
in air-gapped environments such as Azure Local disconnected operations, where public registries are
unreachable and images must be imported first.
''')
param imageRegistry string = 'mcr.microsoft.com'

@description('Repository holding the Azurite image within the registry.')
param imageRepository string = 'azure-storage/azurite'

@description('''
Name of an existing Kubernetes image pull secret in the application namespace. Required when the
registry needs authentication: kubelet pulls this image, and it uses neither the Radius control
plane's registry credentials nor the application's own pull secret.
''')
param imagePullSecretName string = ''

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var uniqueName = 'azurite-${uniqueString(context.resource.id)}'
var containerName = context.resource.properties.?containerName ?? 'data'
var blobPort = 10000

// Azurite's well-known development account. These are public constants published by Microsoft for
// the emulator, not credentials for any real storage account.
var accountName = 'devstoreaccount1'
var accountKey = 'Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw=='
var host = '${uniqueName}.${context.runtime.kubernetes.namespace}.svc.cluster.local'
var blobEndpoint = 'http://${host}:${blobPort}/${accountName}'

resource azurite 'apps/Deployment@v1' = {
  metadata: {
    name: uniqueName
  }
  spec: {
    selector: {
      matchLabels: {
        app: 'azurite'
        resource: context.resource.name
      }
    }
    template: {
      metadata: {
        labels: {
          app: 'azurite'
          resource: context.resource.name
          'radapp.io/application': context.application == null ? '' : context.application.name
        }
      }
      spec: union(
        empty(imagePullSecretName) ? {} : { imagePullSecrets: [ { name: imagePullSecretName } ] },
        {
        containers: [
          {
            name: 'azurite'
            image: '${imageRegistry}/${imageRepository}:${tag}'
            args: [
              'azurite-blob'
              '--blobHost'
              '0.0.0.0'
              '--blobPort'
              '${blobPort}'
              '--skipApiVersionCheck'
              // Azurite infers the storage account from the first DNS label of the request host
              // unless told otherwise. Reached through a Kubernetes Service DNS name it would read
              // the account as 'azurite-<hash>' and reject every request with 400. This forces it
              // to take the account from the URL path, which is what the connection string below
              // expresses.
              '--disableProductStyleUrl'
            ]
            ports: [
              {
                containerPort: blobPort
              }
            ]
            resources: {
              requests: {
                cpu: '50m'
                memory: '128Mi'
              }
              limits: {
                memory: '512Mi'
              }
            }
            readinessProbe: {
              tcpSocket: {
                // Kubernetes IntOrString: a numeric port must be an integer. A string is only
                // valid for a named port, so the Bicep type warning here is a false positive.
                #disable-next-line BCP036
                port: blobPort
              }
              initialDelaySeconds: 5
              periodSeconds: 5
              failureThreshold: 12
            }
          }
        ]
        }
      )
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: uniqueName
    labels: {
      name: uniqueName
    }
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      app: 'azurite'
      resource: context.resource.name
    }
    ports: [
      {
        name: 'blob'
        port: blobPort
        #disable-next-line BCP036
        targetPort: blobPort
      }
    ]
  }
}

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${svc.metadata.namespace}/providers/core/Service/${svc.metadata.name}'
    '/planes/kubernetes/local/namespaces/${azurite.metadata.namespace}/providers/apps/Deployment/${azurite.metadata.name}'
  ]
  values: {
    accountName: accountName
    endpoint: blobEndpoint
    containerName: containerName
  }
  secrets: {
    #disable-next-line outputs-should-not-contain-secrets
    accountKey: accountKey
    #disable-next-line outputs-should-not-contain-secrets
    connectionString: 'DefaultEndpointsProtocol=http;AccountName=${accountName};AccountKey=${accountKey};BlobEndpoint=${blobEndpoint};'
  }
}
