// Recipe: BusinessContinuity.Messaging/messageQueues -> RabbitMQ container in the cluster.
//
// Used by the local (kind) and Azure Local environments where no Azure Service Bus exists.
// Publishes provider = 'rabbitmq' so the worker selects the RabbitMQ client at startup.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Tag of the rabbitmq container image to deploy.')
param tag string = '4-management-alpine'

@description('''
Registry serving the RabbitMQ image. Empty means Docker Hub. Set this to a local registry, for
example `myacr.azurecr.io`, in air-gapped environments such as Azure Local disconnected operations,
where public registries are unreachable and images must be imported first.
''')
param imageRegistry string = ''

@description('Repository holding the RabbitMQ image within the registry.')
param imageRepository string = 'rabbitmq'

@description('''
Name of an existing Kubernetes image pull secret in the application namespace. Required when the
registry needs authentication: kubelet pulls this image, and it uses neither the Radius control
plane's registry credentials nor the application's own pull secret.
''')
param imagePullSecretName string = ''

@description('Username for the RabbitMQ broker.')
param username string = 'bcd'

@description('''
Issuer URL of the token service, for example `https://keycloak/realms/bcd`. Setting this turns on
the OAuth 2.0 backend, so workloads authenticate with a token instead of the generated password.
The password remains in place for the management interface.
''')
param oauthIssuer string = ''

@description('Audience the broker requires in a token. Must match the audience the issuer stamps.')
param oauthResourceServerId string = 'rabbitmq'

@description('Claim the broker reads permissions from, since Keycloak cannot express them as scopes.')
param oauthScopesKey string = 'rabbitmq_scopes'

@description('Existing Secret holding the issuer certificate authority under the key `ca.crt`.')
param oauthCaSecretName string = ''

@description('Client the workload authenticates as at the issuer.')
param oauthClientId string = 'bcd-workloads'

@description('Path where the workload finds its projected ServiceAccount token.')
param oauthAssertionFile string = '/var/run/secrets/tokens/keycloak'

@description('Path where the workload finds the issuer certificate authority.')
param oauthCaFile string = '/etc/bcd/identity-ca/ca.crt'

var image = empty(imageRegistry) ? '${imageRepository}:${tag}' : '${imageRegistry}/${imageRepository}:${tag}'

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var uniqueName = 'rabbitmq-${uniqueString(context.resource.id)}'
var queueName = context.resource.properties.?queueName ?? context.resource.name
var amqpPort = 5672
var managementPort = 15672

// Deterministic per-resource password. Recreating the resource rotates it.
var password = uniqueString(context.resource.id, 'rabbitmq-password')

var oauthEnabled = !empty(oauthIssuer)
var configName = '${uniqueName}-oauth'

// The internal backend stays second so the generated password still reaches the management UI
// after a token is rejected.
var oauthConf = join([
  // Mounting this file replaces the image's own conf.d, which is where console logging is turned
  // on, so it is restored here or the broker's logs stop reaching kubectl.
  'log.console = true'
  'auth_backends.1 = rabbit_auth_backend_oauth2'
  'auth_backends.2 = internal'
  'auth_oauth2.resource_server_id = ${oauthResourceServerId}'
  'auth_oauth2.issuer = ${oauthIssuer}'
  'auth_oauth2.additional_scopes_key = ${oauthScopesKey}'
  'auth_oauth2.preferred_username_claims.1 = preferred_username'
  empty(oauthCaSecretName) ? '' : 'auth_oauth2.https.cacertfile = /etc/rabbitmq/oauth-ca/ca.crt'
  ''
], '\n')

resource oauthConfig 'core/ConfigMap@v1' = if (oauthEnabled) {
  metadata: {
    name: configName
  }
  data: {
    enabled_plugins: '[rabbitmq_management,rabbitmq_auth_backend_oauth2].'
    '10-oauth.conf': oauthConf
  }
}

var oauthEnv = oauthEnabled ? [
  {
    name: 'RABBITMQ_ENABLED_PLUGINS_FILE'
    value: '/etc/rabbitmq/plugins/enabled_plugins'
  }
] : []

var oauthMounts = concat(
  oauthEnabled ? [
    {
      name: 'oauth-conf'
      mountPath: '/etc/rabbitmq/conf.d'
      readOnly: true
    }
    {
      name: 'oauth-plugins'
      mountPath: '/etc/rabbitmq/plugins'
      readOnly: true
    }
  ] : [],
  oauthEnabled && !empty(oauthCaSecretName) ? [
    {
      name: 'oauth-ca'
      mountPath: '/etc/rabbitmq/oauth-ca'
      readOnly: true
    }
  ] : []
)

var oauthVolumes = concat(
  oauthEnabled ? [
    {
      name: 'oauth-conf'
      configMap: {
        name: configName
        items: [
          {
            key: '10-oauth.conf'
            path: '10-oauth.conf'
          }
        ]
      }
    }
    {
      name: 'oauth-plugins'
      configMap: {
        name: configName
        items: [
          {
            key: 'enabled_plugins'
            path: 'enabled_plugins'
          }
        ]
      }
    }
  ] : [],
  oauthEnabled && !empty(oauthCaSecretName) ? [
    {
      name: 'oauth-ca'
      secret: {
        secretName: oauthCaSecretName
        items: [
          {
            key: 'ca.crt'
            path: 'ca.crt'
          }
        ]
      }
    }
  ] : []
)

resource rabbitmq 'apps/Deployment@v1' = {
  metadata: {
    name: uniqueName
  }
  spec: {
    selector: {
      matchLabels: {
        app: 'rabbitmq'
        resource: context.resource.name
      }
    }
    template: {
      metadata: {
        labels: {
          app: 'rabbitmq'
          resource: context.resource.name
          // Lets `rad run` locate the logs for this application.
          'radapp.io/application': context.application == null ? '' : context.application.name
        }
      }
      spec: union(
        empty(imagePullSecretName) ? {} : { imagePullSecrets: [ { name: imagePullSecretName } ] },
        empty(oauthVolumes) ? {} : { volumes: oauthVolumes },
        {
        containers: [
          {
            name: 'rabbitmq'
            image: image
            ports: [
              {
                containerPort: amqpPort
              }
              {
                containerPort: managementPort
              }
            ]
            volumeMounts: oauthMounts
            env: concat([
              {
                name: 'RABBITMQ_DEFAULT_USER'
                value: username
              }
              {
                name: 'RABBITMQ_DEFAULT_PASS'
                value: password
              }
            ], oauthEnv)
            resources: {
              requests: {
                cpu: '100m'
                memory: '256Mi'
              }
              limits: {
                memory: '512Mi'
              }
            }
            readinessProbe: {
              // `rabbitmq-diagnostics ping` starts a second Erlang node and takes several seconds,
              // which always exceeds the default 1s probe timeout and leaves the pod NotReady.
              // A TCP check on the AMQP port is cheap and is what actually matters to clients.
              tcpSocket: {
                #disable-next-line BCP036
                port: amqpPort
              }
              initialDelaySeconds: 20
              periodSeconds: 10
              failureThreshold: 12
            }
          }
        ]
        }
      )
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: uniqueName
    labels: {
      name: uniqueName
    }
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      app: 'rabbitmq'
      resource: context.resource.name
    }
    ports: [
      {
        name: 'amqp'
        port: amqpPort
        #disable-next-line BCP036
        targetPort: amqpPort
      }
      {
        name: 'management'
        port: managementPort
        #disable-next-line BCP036
        targetPort: managementPort
      }
    ]
  }
}

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${svc.metadata.namespace}/providers/core/Service/${svc.metadata.name}'
    '/planes/kubernetes/local/namespaces/${rabbitmq.metadata.namespace}/providers/apps/Deployment/${rabbitmq.metadata.name}'
  ]
  values: union(
    {
      provider: 'rabbitmq'
      queueName: queueName
      host: '${svc.metadata.name}.${svc.metadata.namespace}.svc.cluster.local'
      port: '${amqpPort}'
    },
    oauthEnabled ? {
      oauthTokenEndpoint: '${oauthIssuer}/protocol/openid-connect/token'
      oauthClientId: oauthClientId
      oauthAssertionFile: oauthAssertionFile
      oauthCaFile: oauthCaFile
    } : {}
  )
  secrets: {
    username: username
    #disable-next-line outputs-should-not-contain-secrets
    password: password
  }
}
