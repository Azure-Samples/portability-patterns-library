// ACR connected registry for the Order Management sample on Azure Local.
//
// A ReadOnly connected registry inside the AKS Arc cluster syncs the listed repositories from the
// cloud registry and serves them on a fixed ClusterIP. Kubelet and the Radius control plane pull from
// that address, so a pod restarted while Azure is unreachable still finds its image and Recipes.
//
// Creates, in the cloud registry: a client scope map and token (what the cluster pulls with), a sync
// scope map and token (what the connected registry syncs with), and the connected registry itself.
// Then, when given a connection string, the Arc extension that runs it in the cluster.
//
// Two things are deliberately not redeployed, because doing so would break a running site:
//   * Tokens. A token PUT without its passwords deletes them, and the passwords are generated by an
//     Azure action, not declared here. Existing tokens are referenced, only missing ones are created.
//   * The Arc extension. Its connection string is write-only, so it is only deployed when
//     syncConnectionString is passed: on first install, or to rotate the sync password.
//
// scripts/azurelocal/connected-registry.ps1 wraps this: it generates the passwords and writes the
// pull secrets and CA into the cluster.

@description('Name of the Premium cloud registry, with its dedicated data endpoint enabled.')
param registryName string

@description('Name of the connected registry. 5-40 alphanumeric characters, starting with a letter.')
param connectedRegistryName string = 'bcdazlocalcr'

@description('Name of the AKS Arc cluster (its Arc connected cluster resource, in this resource group).')
param clusterName string = 'bcd-aksarc'

@description('Repositories synced into the cluster, for example oms/api.')
param repositories array

@description('Token the cluster pulls from the connected registry with. Also the name of its scope map.')
param clientTokenName string = 'bcd-azurelocal-pull'

@description('Create the client token. Set false once it exists, or its password is deleted.')
param createClientToken bool = true

@description('Create the sync token. Set false once it exists, or its password is deleted.')
param createSyncToken bool = true

@description('''
Connection string for the connected registry, from `az acr connected-registry get-settings
--generate-password 1`. When set, the Arc extension is installed or updated with it; leave empty to
leave the extension untouched.
''')
@secure()
param syncConnectionString string = ''

@description('Name of the Arc extension.')
param extensionName string = 'bcd-connected-registry'

@description('ClusterIP the connected registry serves on. Must be unused and inside the service CIDR.')
param serviceClusterIp string = '10.96.0.50'

@description('StorageClass of the connected registry volume.')
param storageClassName string = 'default'

@description('Size of the connected registry volume.')
param storageRequest string = '40Gi'

resource registry 'Microsoft.ContainerRegistry/registries@2023-07-01' existing = {
  name: registryName
}

resource connectedCluster 'Microsoft.Kubernetes/connectedClusters@2024-12-01-preview' existing = {
  name: clusterName
}

var readActions = flatten(map(repositories, repository => [
  'repositories/${repository}/content/read'
  'repositories/${repository}/metadata/read'
]))

// The connected registry reports status and reads its configuration through these gateway actions.
var gatewayActions = [
  'gateway/${connectedRegistryName}/config/read'
  'gateway/${connectedRegistryName}/config/write'
  'gateway/${connectedRegistryName}/message/read'
  'gateway/${connectedRegistryName}/message/write'
]

resource clientScopeMap 'Microsoft.ContainerRegistry/registries/scopeMaps@2023-07-01' = {
  parent: registry
  name: clientTokenName
  properties: {
    description: 'Read access for in-cluster pulls from the Azure Local connected registry'
    actions: readActions
  }
}

resource clientToken 'Microsoft.ContainerRegistry/registries/tokens@2023-07-01' = if (createClientToken) {
  parent: registry
  name: clientTokenName
  properties: {
    scopeMapId: clientScopeMap.id
    status: 'enabled'
  }
}

resource syncScopeMap 'Microsoft.ContainerRegistry/registries/scopeMaps@2023-07-01' = {
  parent: registry
  name: connectedRegistryName
  properties: {
    description: 'Sync access for the connected registry ${connectedRegistryName}'
    actions: concat(readActions, gatewayActions)
  }
}

resource syncToken 'Microsoft.ContainerRegistry/registries/tokens@2023-07-01' = if (createSyncToken) {
  parent: registry
  name: connectedRegistryName
  properties: {
    scopeMapId: syncScopeMap.id
    status: 'enabled'
  }
}

// Computed rather than taken from the token resources, which may not be part of this deployment.
var clientTokenId = resourceId('Microsoft.ContainerRegistry/registries/tokens', registryName, clientTokenName)
var syncTokenId = resourceId('Microsoft.ContainerRegistry/registries/tokens', registryName, connectedRegistryName)

// No sync window: the connected registry syncs continuously while the site is connected.
resource connectedRegistry 'Microsoft.ContainerRegistry/registries/connectedRegistries@2025-11-01' = {
  parent: registry
  name: connectedRegistryName
  properties: {
    mode: 'ReadOnly'
    parent: {
      syncProperties: {
        tokenId: syncTokenId
        schedule: '* * * * *'
        messageTtl: 'P2D'
      }
    }
    clientTokenIds: [
      clientTokenId
    ]
    logging: {
      logLevel: 'Information'
      auditLogStatus: 'Disabled'
    }
    // Deletes blobs no longer referenced by a synced tag, daily.
    garbageCollection: {
      enabled: true
      schedule: '0 0 * * *'
    }
  }
  dependsOn: [
    clientToken
    syncToken
  ]
}

// Brings cert-manager and distributes the registry's CA to every node, so kubelet trusts it.
resource extension 'Microsoft.KubernetesConfiguration/extensions@2023-05-01' = if (!empty(syncConnectionString)) {
  name: extensionName
  scope: connectedCluster
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    extensionType: 'Microsoft.ContainerRegistry.ConnectedRegistry'
    autoUpgradeMinorVersion: true
    releaseTrain: 'Stable'
    scope: {
      cluster: {
        releaseNamespace: 'connected-registry'
      }
    }
    configurationSettings: {
      'service.clusterIP': serviceClusterIp
      'pvc.storageClassName': storageClassName
      'pvc.storageRequest': storageRequest
    }
    configurationProtectedSettings: {
      connectionString: syncConnectionString
    }
  }
  dependsOn: [
    connectedRegistry
  ]
}

output registryLoginServer string = registry.properties.loginServer
output connectedRegistryName string = connectedRegistry.name
output clientTokenName string = clientTokenName
