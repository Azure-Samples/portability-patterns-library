# Site values Keycloak substitutes into realm.json when it imports the realm. Edit these for your
# site, then create the ConfigMap:
#   kubectl -n identity create configmap keycloak-realm-settings --from-env-file=realm-settings.env

# Domain controller, over LDAPS. Use the name in its certificate, not its address.
LDAP_URL=ldaps://dc01.contoso.local:636

# OU holding the app's users and groups (oms-app-readers, oms-app-writers). Keycloak reads only this OU.
LDAP_USERS_DN=OU=OMS,DC=contoso,DC=local

# The cluster's service account token issuer: `kubectl get --raw /.well-known/openid-configuration`.
# AKS enabled by Arc uses the in-cluster default below.
KUBERNETES_ISSUER=https://kubernetes.default.svc.cluster.local

# Service account the app's pods run as, in the app's namespace. Must match the Recipe Pack.
WORKLOAD_SUBJECT=system:serviceaccount:oms-azurelocal:oms-workload

# Address users open the app at.
SPA_ORIGIN=https://orders.contoso.local
