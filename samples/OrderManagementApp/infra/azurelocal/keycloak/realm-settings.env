# Site values for Keycloak's address and for the ${...} placeholders in realm.json, which
# realm-config.yaml fills in on every deployment. Edit these for your site, then create or update the
# ConfigMap:
#   kubectl -n identity create configmap keycloak-realm-settings --from-env-file=realm-settings.env --dry-run=client -o yaml | kubectl apply -f -

# Keycloak's own address: https on the load balancer address its Service (service.yaml) got. Tokens
# name it as their issuer, so it must be what browsers and pods use. Keycloak reads it when it starts,
# so after changing it restart Keycloak (keycloak.ps1 does this for you).
KC_HOSTNAME=https://10.0.0.51

# Domain controller, over LDAPS. Use the name in its certificate, not its address.
LDAP_URL=ldaps://dc01.contoso.local:636

# OU holding the app's users and groups (oms-app-readers, oms-app-writers, oms-inventory-admins). Keycloak reads only this OU.
LDAP_USERS_DN=OU=OMS,DC=contoso,DC=local

# The cluster's service account token issuer: `kubectl get --raw /.well-known/openid-configuration`.
# AKS enabled by Arc uses the in-cluster default below.
KUBERNETES_ISSUER=https://kubernetes.default.svc.cluster.local

# Where Keycloak fetches the cluster's signing keys: the API server inside the cluster. Never the
# issuer's own address, which with Arc workload identity is a public Azure URL.
KUBERNETES_ISSUER_DISCOVERY_URL=https://kubernetes.default.svc

# The app's namespace. Each service runs there as a service account named after it (api, processor),
# which the realm's workload-<service> clients trust.
WORKLOAD_NAMESPACE=oms-azurelocal

# Address users open the app at.
SPA_ORIGIN=https://orders.contoso.local

# Grafana's address, with its /grafana path and no trailing slash: on the app's ingress address.
# Grafana sign-in redirects back to it. Must match what provision-observability.ps1 serves Grafana on.
GRAFANA_ORIGIN=https://orders.contoso.local/grafana

# The 'grafana' client's secret is not set here: realm-config.yaml reads it from Secret identity/grafana-oauth
# (key client-secret), which keycloak.ps1 generates once and provision-observability.ps1 copies.