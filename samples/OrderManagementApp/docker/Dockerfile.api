# Build from the sample root:
#   docker build -f docker/Dockerfile.api -t oms-api:local .

FROM mcr.microsoft.com/dotnet/sdk:10.0.404 AS build
WORKDIR /src

# NuGet.Config is optional (redirects restore where nuget.org is unreachable). Paired with a file
# that always exists, the glob may match nothing under both Docker and podman/buildah.
COPY Directory.Build.props NuGet.Confi[g] ./
COPY src/OrderManagement.Shared/OrderManagement.Shared.csproj src/OrderManagement.Shared/
COPY src/OrderManagement.Api/OrderManagement.Api.csproj src/OrderManagement.Api/
RUN dotnet restore src/OrderManagement.Api/OrderManagement.Api.csproj

COPY src/ src/
RUN dotnet publish src/OrderManagement.Api/OrderManagement.Api.csproj -c Release -o /app --no-restore

# The API hosts the orders API and the browser app, so it needs the ASP.NET Core runtime.
FROM mcr.microsoft.com/dotnet/aspnet:10.0.15 AS runtime
WORKDIR /app
COPY --from=build /app ./
EXPOSE 8080

# Run as a non-root user; required by most cluster admission policies.
USER $APP_UID

ENTRYPOINT ["dotnet", "OrderManagement.Api.dll"]
