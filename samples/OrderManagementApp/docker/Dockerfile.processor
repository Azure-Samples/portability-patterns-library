# Build from the sample root:
#   docker build -f docker/Dockerfile.processor -t oms-processor:local .

FROM mcr.microsoft.com/dotnet/sdk:9.0.320 AS build
WORKDIR /src

# NuGet.Config is optional (redirects restore where nuget.org is unreachable). Paired with a file
# that always exists, the glob may match nothing under both Docker and podman/buildah.
COPY Directory.Build.props NuGet.Confi[g] ./
COPY src/OrderManagement.Shared/OrderManagement.Shared.csproj src/OrderManagement.Shared/
COPY src/OrderManagement.Processor/OrderManagement.Processor.csproj src/OrderManagement.Processor/
RUN dotnet restore src/OrderManagement.Processor/OrderManagement.Processor.csproj

COPY src/ src/
RUN dotnet publish src/OrderManagement.Processor/OrderManagement.Processor.csproj -c Release -o /app --no-restore

# A worker that serves HTTP only for its health probes, so it needs the ASP.NET Core runtime.
FROM mcr.microsoft.com/dotnet/aspnet:9.0.22 AS runtime
WORKDIR /app
COPY --from=build /app ./
EXPOSE 8080

# Run as a non-root user; required by most cluster admission policies.
USER $APP_UID

ENTRYPOINT ["dotnet", "OrderManagement.Processor.dll"]
