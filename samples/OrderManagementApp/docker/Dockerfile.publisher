# Build both workers from the repository root:
#   docker build -f docker/Dockerfile.publisher -t bcd-publisher:latest .
#
# In air-gapped environments such as Azure Local disconnected operations, mcr.microsoft.com is
# unreachable. Import the .NET base images into the local registry and point the build at it:
#   docker build --build-arg BASE_REGISTRY=myacr.azurecr.io -f docker/Dockerfile.publisher .

ARG BASE_REGISTRY=mcr.microsoft.com

FROM ${BASE_REGISTRY}/dotnet/sdk:9.0 AS build
WORKDIR /src

# NuGet.Config is optional (redirects restore where nuget.org is unreachable). Paired with a file
# that always exists, the glob may match nothing under both Docker and podman/buildah.
COPY Directory.Build.props NuGet.Confi[g] ./
COPY src/Bcd.Shared/Bcd.Shared.csproj src/Bcd.Shared/
COPY src/Bcd.Publisher/Bcd.Publisher.csproj src/Bcd.Publisher/
RUN dotnet restore src/Bcd.Publisher/Bcd.Publisher.csproj

COPY src/ src/
RUN dotnet publish src/Bcd.Publisher/Bcd.Publisher.csproj -c Release -o /app --no-restore

# The publisher hosts the orders API and the browser app, so it needs the ASP.NET Core runtime.
FROM ${BASE_REGISTRY}/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY --from=build /app ./
EXPOSE 8080

# Run as a non-root user; required by most cluster admission policies.
USER $APP_UID

ENTRYPOINT ["dotnet", "Bcd.Publisher.dll"]
