# Build from the sample root:
#   docker build -f docker/Dockerfile.dbsetup -t oms-dbsetup:local .

FROM mcr.microsoft.com/dotnet/sdk:9.0.320 AS build
WORKDIR /src

# NuGet.Config is optional (redirects restore where nuget.org is unreachable). Paired with a file
# that always exists, the glob may match nothing under both Docker and podman/buildah.
COPY Directory.Build.props NuGet.Confi[g] ./
COPY src/OrderManagement.Shared/OrderManagement.Shared.csproj src/OrderManagement.Shared/
COPY src/OrderManagement.DbSetup/OrderManagement.DbSetup.csproj src/OrderManagement.DbSetup/
RUN dotnet restore src/OrderManagement.DbSetup/OrderManagement.DbSetup.csproj

COPY src/ src/
RUN dotnet publish src/OrderManagement.DbSetup/OrderManagement.DbSetup.csproj -c Release -o /app --no-restore

# A one-shot job that runs to completion before the services start.
FROM mcr.microsoft.com/dotnet/runtime:9.0.22 AS runtime
WORKDIR /app
COPY --from=build /app ./

# Run as a non-root user; required by most cluster admission policies.
USER $APP_UID

ENTRYPOINT ["dotnet", "OrderManagement.DbSetup.dll"]