# Copy this file to .env and choose your own values. docker compose reads .env automatically,
# and .env is ignored by git.

# Password for the local RabbitMQ container.
RABBITMQ_PASSWORD=<choose-a-password>

# Password for the local SQL Server container. SQL Server requires at least 8 characters
# from three of: upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=<choose-a-strong-password>