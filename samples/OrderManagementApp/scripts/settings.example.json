{
  "Azure": {
    "Common": {
      "SubscriptionId": "<subscription-id>",
      "Location": "eastus2",
      "ResourceGroup": "bcd-infra",
      "ClusterName": "bcd-aks",
      "KubeContext": "bcd-aks",
      "WorkspaceName": "oms-azure"
    },
    "Cluster": {
      "RegistryName": "<globally-unique-acr-name>",
      "AlertEmail": "<on-call-email>",
      "UsePrivateEndpoints": false
    },
    "Ingress": {
      "DnsLabel": "<dns-label>",
      "PrivateCa": false
    },
    "Identity": {
      "SpaOrigins": [ "https://<dns-label>.eastus2.cloudapp.azure.com" ]
    },
    "Deploy": {
      "Registry": "<globally-unique-acr-name>.azurecr.io",
      "IngressCertIssuer": "letsencrypt"
    }
  },
  "AzureLocal": {
    "Common": {
      "SubscriptionId": "<subscription-id>",
      "ResourceGroup": "bcd-azurelocal",
      "ClusterName": "bcd-aksarc",
      "KubeContext": "bcd-aksarc",
      "RegistryName": "<acr-name>",
      "ApplicationNamespace": "oms-azurelocal",
      "Availability": "high"
    },
    "Cluster": {
      "Location": "<azure-local-instance-region>",
      "AzureLocalResourceGroup": "<azure-local-resource-group>",
      "CustomLocationName": "<azure-local-custom-location>",
      "VmSwitchName": "<vm-switch-name>",
      "AddressPrefix": "<node-subnet-cidr>",
      "Gateway": "<subnet-gateway>",
      "DnsServers": [ "<active-directory-dns-server>" ],
      "IpPoolStart": "<first-node-address>",
      "IpPoolEnd": "<last-node-address>",
      "ControlPlaneIp": "<free-address-outside-the-node-pool>",
      "LoadBalancerAddresses": "<first-address>-<last-address>"
    },
    "Images": {
      "Mode": "Mirror",
      "Registry": "<acr-name>.azurecr.io"
    },
    "Registry": {
      "ServiceClusterIp": "<unused-address-in-the-cluster-service-range>",
      "StorageClassName": "default"
    },
    "KeyVault": {
      "SecretsOfficerObjectIds": [ "<operations-group-object-id>" ]
    },
    "Keycloak": {
      "AdServer": "<domain-controller-fqdn>",
      "AdDomain": "<ad-domain>",
      "AdBindUpn": "svc-keycloak@<ad-domain>",
      "AdCaCertificatePath": "<path-to-directory-ca.crt>",
      "AllowInClusterIssuer": true
    },
    "Observability": {
      "StorageClassName": "",
      "PrometheusRetention": "15d",
      "PrometheusStorage": "5Gi",
      "LokiRetention": "168h",
      "LokiStorage": "5Gi",
      "TempoRetention": "72h",
      "TempoStorage": "5Gi",
      "SmtpHost": "",
      "SmtpPort": 587,
      "SmtpFrom": "",
      "AlertEmailTo": "",
      "SmtpUsername": "",
      "SmtpPasswordSecret": ""
    },
    "Ingress": {
      "HostNames": []
    },
    "Deploy": {}
  }
}
