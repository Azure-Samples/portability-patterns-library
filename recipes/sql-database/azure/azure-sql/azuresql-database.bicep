// Recipe: Radius.Data/sqlServerDatabases -> Azure SQL Database (managed PaaS).
//
// The same Resource Type is backed by a SQL Server container on Azure Local. Switching environments changes the Recipe, never the application.
//
// The Entra ID administrator is a dedicated database-administrator identity, used only by the
// database setup job, which creates a least-privilege database user for each service's managed
// identity. Services sign in with Workload Identity and no password, and never as administrator.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Azure region for the SQL logical server. Defaults to the resource group location.')
param location string = resourceGroup().location

@description('Client ID of the database-administrator managed identity, set as the Entra ID administrator of the server. Azure SQL identifies an application or managed identity by its client ID, not its object ID.')
param administratorClientId string

@description('Name of that managed identity.')
param administratorName string

@description('Entra ID tenant that the administrator principal belongs to.')
param tenantId string = subscription().tenantId

@description('Database SKU name.')
param skuName string = 'S0'

@description('Maximum database size in bytes. Defaults to 2 GB.')
param maxSizeBytes int = 2147483648

@description('''
Disable SQL authentication entirely and accept only Microsoft Entra ID tokens. Recommended, and the
modern Azure default: no administrator password is created, so there is no password to leak, rotate
or store. The Radius Resource Type still requires `username` and `password` properties, but this
Recipe ignores them when Entra-only authentication is on.
''')
param azureAdOnlyAuthentication bool = true

@description('Subnet for a private endpoint to the server. Empty keeps public access and creates no endpoint.')
param privateEndpointSubnetId string = ''

@description('Private DNS zone (privatelink.database...) the endpoint registers in. Required with privateEndpointSubnetId.')
param privateDnsZoneId string = ''

@description('Region of the private endpoint: the virtual network\'s, which may differ from the server\'s.')
param privateEndpointLocation string = location

var usePrivateEndpoint = !empty(privateEndpointSubnetId)

var radiusTags = {
  'radapp.io-application': context.application == null ? '' : context.application.name
  'radapp.io-environment': context.environment.name
  'radapp.io-resource': context.resource.name
}

var database = context.resource.properties.database
var administratorLogin = context.resource.properties.username
var administratorPassword = context.resource.properties.password

// SQL logical server names are globally unique and must be lowercase. The resource group is part of
// the hash because the Radius resource ID is the same in every deployment of an app, so two
// deployments in one subscription would otherwise get the same name. The location is part of the
// hash because a server name is bound to a region: Azure reserves the name against the region of
// the first (even failed) creation attempt, and refuses to reuse it elsewhere with
// "A resource with the same name cannot be created in location ...". Seeding with the location
// means changing regions yields a new name instead of colliding with the reservation.
var serverName = take('sql-${uniqueString(resourceGroup().id, context.resource.id, location)}', 63)

resource sqlServer 'Microsoft.Sql/servers@2023-08-01-preview' = {
  name: serverName
  location: location
  properties: union(
    {
      minimalTlsVersion: '1.2'
      publicNetworkAccess: usePrivateEndpoint ? 'Disabled' : 'Enabled'
      administrators: {
        administratorType: 'ActiveDirectory'
        principalType: 'Application'
        login: administratorName
        sid: administratorClientId
        tenantId: tenantId
        azureADOnlyAuthentication: azureAdOnlyAuthentication
      }
    },
    // `administratorLogin` is optional on Microsoft.Sql/servers: only `name` and `location` are
    // required. With Entra-only authentication no SQL login is created at all, so the developer's
    // username and password are never sent to Azure and no password exists to protect.
    azureAdOnlyAuthentication ? {} : {
      administratorLogin: administratorLogin
      #disable-next-line use-secure-value-for-secure-inputs
      administratorLoginPassword: administratorPassword
    }
  )
  tags: radiusTags
}

resource sqlDatabase 'Microsoft.Sql/servers/databases@2023-08-01-preview' = {
  parent: sqlServer
  name: database
  location: location
  sku: {
    name: skuName
  }
  properties: {
    maxSizeBytes: maxSizeBytes
    zoneRedundant: false
  }
}

// Without a private endpoint: allows other Azure services, including the AKS cluster's egress, to
// reach the server. Set privateEndpointSubnetId for production.
resource allowAzureServices 'Microsoft.Sql/servers/firewallRules@2023-08-01-preview' = if (!usePrivateEndpoint) {
  parent: sqlServer
  name: 'AllowAllWindowsAzureIps'
  properties: {
    startIpAddress: '0.0.0.0'
    endIpAddress: '0.0.0.0'
  }
}

resource privateEndpoint 'Microsoft.Network/privateEndpoints@2024-05-01' = if (usePrivateEndpoint) {
  name: 'pe-${serverName}'
  location: privateEndpointLocation
  properties: {
    subnet: {
      id: privateEndpointSubnetId
    }
    privateLinkServiceConnections: [
      {
        name: 'sqlServer'
        properties: {
          privateLinkServiceId: sqlServer.id
          groupIds: [
            'sqlServer'
          ]
        }
      }
    ]
  }
  tags: radiusTags
}

resource privateDnsZoneGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2024-05-01' = if (usePrivateEndpoint) {
  parent: privateEndpoint
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'sql'
        properties: {
          privateDnsZoneId: privateDnsZoneId
        }
      }
    ]
  }
}

output result object = {
  resources: concat([
    sqlServer.id
    sqlDatabase.id
  ], usePrivateEndpoint ? [ privateEndpoint.id ] : [])
  values: {
    host: sqlServer.properties.fullyQualifiedDomainName
    port: 1433
    database: database
    // Azure SQL only accepts encrypted connections, with a certificate from a public CA.
    tls: 'required'
  }
}
