// Recipe: Radius.Data/sqlServerDatabases -> SQL Server 2022 container in the cluster.
//
// Used by the Azure Local environment. The Azure environment binds this same Resource
// Type to Azure SQL Database instead, which is why the application never hardcodes either one.
//
// With the Kerberos parameters set, SQL Server also accepts Active Directory (Kerberos) logins, and
// the listed Windows logins are created at startup. Applications whose pods carry a client keytab
// then connect with integrated authentication instead of a SQL password. AD lives on site, so this
// keeps working when the link to Azure is down.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Tag of the mssql/server container image to deploy.')
param tag string = '2022-latest'

@description('''
Registry serving the SQL Server image. On Azure Local this is the in-cluster
connected registry, so a restarted pod still finds its image while the link to Azure is down.
''')
param imageRegistry string = 'mcr.microsoft.com'

@description('Repository holding the SQL Server image within the registry.')
param imageRepository string = 'mssql/server'

@description('''
Name of an existing Kubernetes image pull secret in the application namespace. Required when the
registry needs authentication: kubelet pulls this image, and it uses neither the Radius control
plane's registry credentials nor the application's own pull secret.
''')
param imagePullSecretName string = ''

@description('SQL Server edition to run. Developer is free for non-production use.')
@allowed([
  'Developer'
  'Express'
  'Standard'
])
param edition string = 'Developer'

@description('''
Existing ConfigMap holding `krb5.conf` for the Active Directory realm. Kerberos is enabled only when
this and kerberosKeytabSecretName are both set.
''')
param kerberosConfigMapName string = ''

@description('''
Existing Secret holding SQL Server's keytab under `mssql.keytab`: keys for kerberosAccount and for the
service principal names MSSQLSvc/<host>:1433 and MSSQLSvc/<host>, where <host> is this resource's
Service, `<resource name>.<namespace>.svc.cluster.local`.
''')
param kerberosKeytabSecretName string = ''

@description('AD account (sAMAccountName) SQL Server runs as for Kerberos and uses to look up Windows logins.')
param kerberosAccount string = ''

@description('Comma-separated Windows logins (DOMAIN\\name) to create and add to dbcreator, typically the application account.')
param windowsLogins string = ''

@description('''
Address of a domain controller, pinned in the pod's hosts file together with directoryHostNames. SQL
Server on Linux resolves the domain's short (NetBIOS) name as a host name to look accounts up, and pods
don't search the AD domain, so without this every Windows login fails with "untrusted domain".
''')
param directoryHostAddress string = ''

@description('Comma-separated names for directoryHostAddress: the controller FQDN, the DNS domain and the short domain name.')
param directoryHostNames string = ''

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var uniqueName = 'mssql-${uniqueString(context.resource.id)}'
var sqlPort = 1433

var useKerberos = !empty(kerberosConfigMapName) && !empty(kerberosKeytabSecretName)
var loginList = filter(map(split(windowsLogins, ','), login => trim(login)), login => !empty(login))

// The service principal name registered in AD must match the host clients connect to, so with
// Kerberos the Service takes the predictable resource name instead of a generated one.
var serviceName = useKerberos ? toLower(context.resource.name) : uniqueName
var kerberosDir = '/etc/mssql-kerberos'

var mssqlConf = join([
  '[network]'
  'kerberoskeytabfile = ${kerberosDir}/mssql.keytab'
  'privilegedadaccount = ${kerberosAccount}'
  ''
], '\n')

// Idempotent: the database has no volume, so the server starts empty after every restart.
var bootstrapSql = join(map(loginList, login => join([
  'IF SUSER_ID(N\'${replace(login, '\'', '\'\'')}\') IS NULL CREATE LOGIN [${replace(login, ']', ']]')}] FROM WINDOWS;'
  'ALTER SERVER ROLE dbcreator ADD MEMBER [${replace(login, ']', ']]')}];'
], '\n')), '\n')

// Starts SQL Server, then creates the Windows logins once it answers. Looking a login up needs the
// domain controller, so it is retried rather than failing the pod. sqlcmd reads the sa password
// from SQLCMDPASSWORD, which keeps it off the command line.
var kerberosStartup = join([
  'cp ${kerberosDir}/mssql.conf /var/opt/mssql/mssql.conf'
  '/opt/mssql/bin/sqlservr &'
  'pid=$!'
  '('
  '  for attempt in $(seq 1 90); do'
  '    if SQLCMDPASSWORD="$MSSQL_SA_PASSWORD" /opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -b -i ${kerberosDir}/bootstrap.sql; then echo "Windows logins ready"; exit 0; fi'
  '    sleep 10'
  '  done'
  '  echo "Windows logins could not be created" >&2'
  ') &'
  'wait $pid'
], '\n')

resource kerberosConfig 'core/ConfigMap@v1' = if (useKerberos) {
  metadata: {
    name: '${uniqueName}-kerberos'
  }
  data: {
    'mssql.conf': mssqlConf
    'bootstrap.sql': bootstrapSql
  }
}

// Supplied by the developer on the resource; marked x-radius-sensitive on the Resource Type so
// Radius encrypts it at rest and only decrypts it for this Recipe.
var saPassword = context.resource.properties.password
var database = context.resource.properties.database

resource mssql 'apps/Deployment@v1' = {
  metadata: {
    name: uniqueName
  }
  spec: {
    selector: {
      matchLabels: {
        app: 'mssql'
        resource: context.resource.name
      }
    }
    template: {
      metadata: {
        labels: {
          app: 'mssql'
          resource: context.resource.name
          'radapp.io/application': context.application == null ? '' : context.application.name
        }
      }
      spec: union(
        empty(imagePullSecretName) ? {} : { imagePullSecrets: [ { name: imagePullSecretName } ] },
        !useKerberos || empty(directoryHostAddress) ? {} : {
          hostAliases: [
            {
              ip: directoryHostAddress
              hostnames: filter(map(split(directoryHostNames, ','), name => trim(name)), name => !empty(name))
            }
          ]
        },
        !useKerberos ? {} : {
          volumes: [
            {
              name: 'mssql-kerberos'
              projected: {
                sources: [
                  { configMap: { name: '${uniqueName}-kerberos' } }
                  { secret: { name: kerberosKeytabSecretName, items: [ { key: 'mssql.keytab', path: 'mssql.keytab' } ] } }
                ]
              }
            }
            {
              name: 'krb5-config'
              configMap: { name: kerberosConfigMapName }
            }
          ]
        },
        {
        terminationGracePeriodSeconds: 30
        containers: [
          {
            name: 'mssql'
            image: '${imageRegistry}/${imageRepository}:${tag}'
            command: useKerberos ? [ '/bin/bash', '-c', kerberosStartup ] : null
            volumeMounts: useKerberos ? [
              {
                name: 'mssql-kerberos'
                mountPath: kerberosDir
                readOnly: true
              }
              {
                name: 'krb5-config'
                mountPath: '/etc/krb5.conf'
                subPath: 'krb5.conf'
                readOnly: true
              }
            ] : null
            ports: [
              {
                containerPort: sqlPort
              }
            ]
            env: [
              {
                name: 'ACCEPT_EULA'
                value: 'Y'
              }
              {
                name: 'MSSQL_SA_PASSWORD'
                value: saPassword
              }
              {
                name: 'MSSQL_PID'
                value: edition
              }
              {
                name: 'MSSQL_AGENT_ENABLED'
                value: 'false'
              }
            ]
            resources: {
              requests: {
                cpu: '250m'
                memory: '2Gi'
              }
              limits: {
                memory: '4Gi'
              }
            }
            readinessProbe: {
              tcpSocket: {
                // Kubernetes IntOrString: a numeric port must be an integer. A string is only
                // valid for a named port, so the Bicep type warning here is a false positive.
                #disable-next-line BCP036
                port: sqlPort
              }
              initialDelaySeconds: 20
              periodSeconds: 10
              failureThreshold: 30
            }
          }
        ]
        }
      )
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: serviceName
    labels: {
      name: serviceName
    }
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      app: 'mssql'
      resource: context.resource.name
    }
    ports: [
      {
        name: 'sql'
        port: sqlPort
        #disable-next-line BCP036
        targetPort: sqlPort
      }
    ]
  }
}

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${svc.metadata.namespace}/providers/core/Service/${svc.metadata.name}'
    '/planes/kubernetes/local/namespaces/${mssql.metadata.namespace}/providers/apps/Deployment/${mssql.metadata.name}'
  ]
  values: {
    host: '${svc.metadata.name}.${svc.metadata.namespace}.svc.cluster.local'
    port: sqlPort
    database: database
    // Without Kerberos the SQL Server container's administrator login is always 'sa', whatever
    // username the application declared; reporting it here means the application never has to
    // know. With Kerberos the application signs in as its own Windows login instead.
    username: useKerberos && !empty(loginList) ? loginList[0] : 'sa'
  }
}
