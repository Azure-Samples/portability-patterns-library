// Recipe: Radius.Data/sqlServerDatabases -> SQL Server 2022 container in the cluster.
//
// Used by the Azure Local environment. The Azure environment binds this same Resource
// Type to Azure SQL Database instead, which is why the application never hardcodes either one.
//
// The administrator login, 'sa', with the password set on the resource, is for the database setup
// job only; services sign in as their own least-privilege logins, which that job creates. The
// databases live on a persistent volume, so they survive the pod being replaced. With a certificate
// issuer, SQL Server accepts encrypted connections only, with a certificate from the site CA that
// clients verify, as they do Azure SQL's.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Tag of the mssql/server container image to deploy: a specific cumulative update.')
param tag string = '2022-CU27-GDR1-ubuntu-22.04'

@description('''
Registry serving the SQL Server image. On Azure Local this is the in-cluster
connected registry, so a restarted pod still finds its image while the link to Azure is down.
''')
param imageRegistry string = 'mcr.microsoft.com'

@description('Repository holding the SQL Server image within the registry.')
param imageRepository string = 'mssql/server'

@description('''
Name of an existing Kubernetes image pull secret in the application namespace. Required when the
registry needs authentication: kubelet pulls this image, and it uses neither the Radius control
plane's registry credentials nor the application's own pull secret.
''')
param imagePullSecretName string = ''

@description('''
SQL Server edition (MSSQL_PID): Express, Standard, Enterprise, a product key, or Developer, which
is free but licensed for development and testing only. Required: the licence is the site's choice.
''')
param edition string

@description('''
CPU cores the container may use. Standard and Enterprise are licensed per core, counted from what
the container can use (with a minimum per container), so this also sets how many cores to license.
''')
param cpuLimit string = '2'

@description('cert-manager ClusterIssuer, a CA issuer such as the site CA, for the server\'s certificate. SQL Server then accepts encrypted connections only. Empty runs without TLS.')
param certificateIssuer string = ''

@description('Size of the persistent volume holding the databases.')
param storageSize string = '10Gi'

@description('Storage class of that volume. Empty uses the cluster default.')
param storageClassName string = ''

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var uniqueName = 'mssql-${uniqueString(context.resource.id)}'
var namespace = context.runtime.kubernetes.namespace
var sqlPort = 1433
// The image's mssql user and group.
var mssqlUserId = 10001
var useTls = !empty(certificateIssuer)
var tlsSecretName = '${uniqueName}-tls'
// SQL Server reads its certificate when it starts. It uses a copy, so a renewed certificate in the
// Secret can be told apart from the one in use (see the liveness probe).
var tlsDir = '/etc/mssql-tls'
var loadedTlsDir = '/var/opt/mssql-tls'

// Supplied by the developer on the resource; marked x-radius-sensitive on the Resource Type so
// Radius encrypts it at rest and only decrypts it for this Recipe. SQL Server only applies it when it
// first creates its system databases on the volume; the sample's deploy script sets a changed one in
// the running server.
var saPassword = context.resource.properties.password
var database = context.resource.properties.database

// The administrator password reaches the container through a Secret rather than the pod spec.
resource admin 'core/Secret@v1' = {
  metadata: {
    name: '${uniqueName}-admin'
  }
  type: 'Opaque'
  stringData: {
    password: saPassword
  }
}

resource data 'core/PersistentVolumeClaim@v1' = {
  metadata: {
    name: '${uniqueName}-data'
  }
  spec: union({
    accessModes: [ 'ReadWriteOnce' ]
    resources: {
      requests: {
        storage: storageSize
      }
    }
  }, empty(storageClassName) ? {} : { storageClassName: storageClassName })
}

// SQL Server's configuration file, copied onto the volume at every start, as Microsoft's Kubernetes
// guidance does. With TLS, encryption is forced, so a client can't connect in the clear.
resource config 'core/ConfigMap@v1' = {
  metadata: {
    name: '${uniqueName}-config'
  }
  data: {
    'mssql.conf': join(concat([
      '[network]'
      'forceencryption = ${useTls ? 1 : 0}'
    ], useTls ? [
      'tlscert = ${loadedTlsDir}/tls.crt'
      'tlskey = ${loadedTlsDir}/tls.key'
      'tlsprotocols = 1.2'
    ] : [], [
      ''
    ]), '\n')
  }
}

// The server's certificate, from the site CA, naming its Service.
#disable-next-line BCP081
resource certificate 'cert-manager.io/Certificate@v1' = if (useTls) {
  metadata: {
    name: tlsSecretName
  }
  spec: {
    secretName: tlsSecretName
    commonName: '${uniqueName}.${namespace}.svc'
    dnsNames: [
      uniqueName
      '${uniqueName}.${namespace}'
      '${uniqueName}.${namespace}.svc'
      '${uniqueName}.${namespace}.svc.cluster.local'
    ]
    // SQL Server needs a key it can use for key exchange, in PKCS#8 form.
    usages: [ 'server auth', 'digital signature', 'key encipherment' ]
    duration: '2160h'
    renewBefore: '720h'
    privateKey: {
      algorithm: 'RSA'
      encoding: 'PKCS8'
      size: 2048
      rotationPolicy: 'Always'
    }
    issuerRef: {
      kind: 'ClusterIssuer'
      name: certificateIssuer
    }
  }
}

// Joined with '\n' rather than written as a multi-line string, which would keep the file's line
// endings: a checkout with CRLF endings would break the shell script.
var startScript = join(concat([
  'set -e'
  'cp /var/opt/mssql-config/mssql.conf /var/opt/mssql/mssql.conf'
], useTls ? [
  'install -m 0600 ${tlsDir}/tls.crt ${tlsDir}/tls.key ${loadedTlsDir}/'
] : [], [
  'exec /opt/mssql/bin/sqlservr'
]), '\n')

resource mssql 'apps/StatefulSet@v1' = {
  dependsOn: [ certificate ]
  metadata: {
    name: uniqueName
  }
  spec: {
    // A StatefulSet starts a replacement pod only once the old one has stopped, so two servers
    // never use the volume at once. A Deployment can overlap them when a pod is deleted or evicted.
    // The volume is the claim above rather than a volumeClaimTemplate, so Radius deletes it with the
    // resource.
    serviceName: svc.metadata.name
    selector: {
      matchLabels: {
        app: 'mssql'
        resource: context.resource.name
      }
    }
    template: {
      metadata: {
        labels: {
          app: 'mssql'
          resource: context.resource.name
          'radapp.io/application': context.application == null ? '' : context.application.name
        }
        // The configuration is read only when the server starts, so a change to it restarts the pod.
        annotations: {
          'portability.radapp.io/config-hash': uniqueString(config.data['mssql.conf'])
        }
      }
      spec: union(
        empty(imagePullSecretName) ? {} : { imagePullSecrets: [ { name: imagePullSecretName } ] },
        {
          terminationGracePeriodSeconds: 30
          // The image runs as the mssql user, which must be able to write to the volume and read
          // the certificate's key (mode 0440, the group from fsGroup).
          securityContext: {
            runAsNonRoot: true
            runAsUser: mssqlUserId
            runAsGroup: mssqlUserId
            fsGroup: mssqlUserId
            seccompProfile: { type: 'RuntimeDefault' }
          }
          volumes: concat([
            {
              name: 'data'
              persistentVolumeClaim: {
                claimName: data.metadata.name
              }
            }
            {
              name: 'config'
              configMap: {
                name: config.metadata.name
              }
            }
          ], useTls ? [
            {
              name: 'tls'
              secret: {
                secretName: tlsSecretName
                defaultMode: 288
              }
            }
            { name: 'tls-loaded', emptyDir: {} }
          ] : [])
          containers: [
            union({
              name: 'mssql'
              image: '${imageRegistry}/${imageRepository}:${tag}'
              // Run by the image's entrypoint, which then starts SQL Server's own setup.
              args: [ '/bin/bash', '-c', startScript ]
              volumeMounts: concat([
                {
                  name: 'data'
                  mountPath: '/var/opt/mssql'
                }
                {
                  name: 'config'
                  mountPath: '/var/opt/mssql-config'
                  readOnly: true
                }
              ], useTls ? [
                {
                  name: 'tls'
                  mountPath: tlsDir
                  readOnly: true
                }
                {
                  name: 'tls-loaded'
                  mountPath: loadedTlsDir
                }
              ] : [])
              ports: [
                {
                  containerPort: sqlPort
                }
              ]
              env: [
                {
                  name: 'ACCEPT_EULA'
                  value: 'Y'
                }
                {
                  name: 'MSSQL_SA_PASSWORD'
                  valueFrom: { secretKeyRef: { name: admin.metadata.name, key: 'password' } }
                }
                {
                  name: 'MSSQL_PID'
                  value: edition
                }
                {
                  name: 'MSSQL_AGENT_ENABLED'
                  value: 'false'
                }
              ]
              // sqlservr carries the file capability to bind low ports, so the kernel refuses to run
              // it unless that capability stays in the container's bounding set.
              securityContext: {
                allowPrivilegeEscalation: false
                capabilities: {
                  drop: [ 'ALL' ]
                  add: [ 'NET_BIND_SERVICE' ]
                }
              }
              resources: {
                requests: {
                  cpu: '250m'
                  memory: '2Gi'
                }
                limits: {
                  cpu: cpuLimit
                  memory: '4Gi'
                }
              }
              readinessProbe: {
                tcpSocket: {
                  // Kubernetes IntOrString: a numeric port must be an integer. A string is only
                  // valid for a named port, so the Bicep type warning here is a false positive.
                  #disable-next-line BCP036
                  port: sqlPort
                }
                initialDelaySeconds: 20
                periodSeconds: 10
                failureThreshold: 30
              }
            },
            // SQL Server doesn't reload its certificate. Once cert-manager has renewed it, a month
            // before the old one expires, this probe fails and the kubelet restarts SQL Server,
            // which then uses the new one.
            useTls ? {
              livenessProbe: {
                exec: {
                  command: [ '/bin/bash', '-c', '[ "$(cat ${tlsDir}/tls.crt)" = "$(cat ${loadedTlsDir}/tls.crt)" ]' ]
                }
                initialDelaySeconds: 60
                periodSeconds: 300
                failureThreshold: 1
              }
            } : {})
          ]
        }
      )
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: uniqueName
    labels: {
      name: uniqueName
    }
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      app: 'mssql'
      resource: context.resource.name
    }
    ports: [
      {
        name: 'sql'
        port: sqlPort
        #disable-next-line BCP036
        targetPort: sqlPort
      }
    ]
  }
}

output result object = {
  // cert-manager leaves the certificate's Secret behind when the Certificate is deleted, so it is
  // listed too, and the private key goes with the resource.
  resources: concat([
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Service/${svc.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/apps/StatefulSet/${mssql.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/PersistentVolumeClaim/${data.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${admin.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/ConfigMap/${config.metadata.name}'
  ], useTls ? [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/cert-manager.io/Certificate/${tlsSecretName}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${tlsSecretName}'
  ] : [])
  values: {
    host: '${svc.metadata.name}.${namespace}.svc.cluster.local'
    port: sqlPort
    database: database
    // The SQL Server container's administrator login is always 'sa', whatever username was declared.
    username: 'sa'
    // The application verifies the certificate against the CAs the platform gives it.
    tls: useTls ? 'required' : 'optional'
  }
}
