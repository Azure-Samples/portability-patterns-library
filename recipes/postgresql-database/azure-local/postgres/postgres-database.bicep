// Recipe: Radius.Data/postgreSqlDatabases -> one PostgreSQL server in a StatefulSet, with no operator.
//
// Used on Azure Local when the Recipe Pack's availability is 'standard' (recipe-packs/azure-local.bicep).
// With 'high' it uses ../cloudnative-pg/postgres-database.bicep instead: a primary with replicas that
// take over, and continuous backups, run by the CloudNativePG operator. Both return the same values,
// and behave the same way, so the application can't tell them apart.
//
// One server, so the database is down while its pod restarts, and there are no backups: a lost volume
// loses the data. The administrator account from the resource is for the database setup job only;
// applications sign in as their own least-privilege roles, which that job creates. As with the
// operator, a changed administrator password is applied to the running server. Connections are
// encrypted with a certificate cert-manager issues from the site's CA and renews; the server reloads
// it without a restart.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Tag of the postgres container image to deploy. Same PostgreSQL version as the CloudNativePG and Azure Recipes.')
param tag string = '17.11-alpine3.24'

@description('''
Registry serving the PostgreSQL image. On Azure Local this is the in-cluster connected registry, so
a restarted pod still finds its image while the link to Azure is down.
''')
param imageRegistry string = 'docker.io/library'

@description('Repository holding the PostgreSQL image within the registry.')
param imageRepository string = 'postgres'

@description('Name of an existing Kubernetes image pull secret in the application namespace.')
param imagePullSecretName string = ''

@description('User and group ID of the image\'s postgres user, which the server runs as: 70 in the Alpine image, 999 in the Debian one.')
param postgresUserId int = 70

@description('''
libc locale of the new cluster's databases (LC_COLLATE and LC_CTYPE). Text is ordered by the ICU
locale below, so the order is the same on every image, as in the CloudNativePG Recipe.
''')
param locale string = 'en_US.UTF-8'

@description('ICU locale that orders text in the new cluster\'s databases.')
param icuLocale string = 'en-US'

@description('cert-manager ClusterIssuer that issues the server certificate. Empty serves without TLS.')
param certificateIssuer string = ''

@description('Size of the persistent volume holding the databases.')
param storageSize string = '5Gi'

@description('Storage class of that volume. Empty uses the cluster default.')
param storageClassName string = ''

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var uniqueName = 'postgres-${uniqueString(context.resource.id)}'
var namespace = context.runtime.kubernetes.namespace
var postgresPort = 5432
var image = '${imageRegistry}/${imageRepository}:${tag}'
var useTls = !empty(certificateIssuer)
var tlsSecretName = '${uniqueName}-tls'
var database = context.resource.properties.?database ?? 'postgres_db'
var adminUsername = context.resource.properties.username
var adminDir = '/etc/postgres-admin'
var socketDir = '/var/run/postgresql'
// The labels the application's network policies select on, as the operator's pods carry them.
var labels = {
  app: 'postgres'
  resource: context.resource.name
}

// The administrator's credentials reach the server as files from a Secret, never in the pod spec.
resource admin 'core/Secret@v1' = {
  metadata: {
    name: '${uniqueName}-admin'
  }
  type: 'Opaque'
  stringData: {
    username: adminUsername
    password: context.resource.properties.password
  }
}

resource data 'core/PersistentVolumeClaim@v1' = {
  metadata: {
    name: '${uniqueName}-data'
  }
  spec: union({
    accessModes: [ 'ReadWriteOnce' ]
    resources: {
      requests: {
        storage: storageSize
      }
    }
  }, empty(storageClassName) ? {} : { storageClassName: storageClassName })
}

// Inside the pod, the server's own user (the operating-system user 'postgres') signs in as the
// administrator over the local socket with no password, as CloudNativePG's instance manager does.
// The sidecar below relies on that, so it keeps working when the password changes. Every other
// local connection needs a password, and with TLS on, only encrypted connections are accepted from
// the network.
resource config 'core/ConfigMap@v1' = {
  metadata: {
    name: '${uniqueName}-config'
  }
  data: {
    'pg_hba.conf': join([
      'local all "${adminUsername}" peer map=admin'
      'local all all scram-sha-256'
      useTls ? 'hostssl all all all scram-sha-256' : 'host all all all scram-sha-256'
      ''
    ], '\n')
    'pg_ident.conf': join([
      'admin postgres "${adminUsername}"'
      ''
    ], '\n')
    // Sets the administrator's password from the Secret, read from files so it never appears on a
    // command line, then reloads the configuration, which picks up a renewed certificate.
    'apply-admin.sql': join([
      '\\set ON_ERROR_STOP on'
      '\\set admin_user `cat ${adminDir}/username`'
      '\\set admin_password `cat ${adminDir}/password`'
      'ALTER ROLE :"admin_user" WITH PASSWORD :\'admin_password\';'
      'SELECT pg_reload_conf();'
      ''
    ], '\n')
  }
}

#disable-next-line BCP081
resource certificate 'cert-manager.io/Certificate@v1' = if (useTls) {
  metadata: {
    name: tlsSecretName
  }
  spec: {
    secretName: tlsSecretName
    commonName: '${uniqueName}.${namespace}.svc'
    dnsNames: [
      uniqueName
      '${uniqueName}.${namespace}'
      '${uniqueName}.${namespace}.svc'
      '${uniqueName}.${namespace}.svc.cluster.local'
    ]
    usages: [ 'server auth' ]
    duration: '2160h'
    renewBefore: '720h'
    privateKey: {
      algorithm: 'RSA'
      size: 2048
      rotationPolicy: 'Always'
    }
    issuerRef: {
      kind: 'ClusterIssuer'
      name: certificateIssuer
    }
  }
}

var serverArgs = concat([
  '-c'
  'hba_file=/etc/postgres-config/pg_hba.conf'
  '-c'
  'ident_file=/etc/postgres-config/pg_ident.conf'
], useTls ? [
  '-c'
  'ssl=on'
  '-c'
  'ssl_cert_file=/etc/postgres-tls/tls.crt'
  '-c'
  'ssl_key_file=/etc/postgres-tls/tls.key'
] : [])

var adminMount = { name: 'admin', mountPath: adminDir, readOnly: true }
var socketMount = { name: 'run', mountPath: socketDir }
var tlsMount = useTls ? [ { name: 'tls', mountPath: '/etc/postgres-tls', readOnly: true } ] : []

// PostgreSQL reads its certificate only at start or on reload, and its administrator's password only
// when it first creates the cluster. This sidecar checks every ten seconds whether the Secret's
// password or the certificate has changed (the kubelet updates mounted Secrets in place), and when
// one has, sets the password and reloads the configuration. It does so once when the pod starts too.
// Joined with '\n' rather than written as a multi-line string, which would keep the file's line
// endings: a checkout with CRLF endings would break the shell script.
var applyScript = join([
  'applied=""'
  'while true; do'
  '  current="$(cat ${adminDir}/username ${adminDir}/password /etc/postgres-tls/tls.crt 2>/dev/null | sha256sum)"'
  '  if [ "$current" != "$applied" ] && pg_isready -q -h ${socketDir}; then'
  '    if psql -X -q -h ${socketDir} -U "$(cat ${adminDir}/username)" -d postgres -f /etc/postgres-config/apply-admin.sql >/dev/null; then'
  '      applied="$current"'
  '    fi'
  '  fi'
  '  sleep 10'
  'done'
], '\n')

// Nothing runs with privileges, and the root file system is read-only: the server writes only to its
// volume, its socket directory and scratch space.
var containerSecurityContext = {
  allowPrivilegeEscalation: false
  capabilities: { drop: [ 'ALL' ] }
  readOnlyRootFilesystem: true
}

resource postgres 'apps/StatefulSet@v1' = {
  dependsOn: [ certificate ]
  metadata: {
    name: uniqueName
  }
  spec: {
    // A StatefulSet starts a replacement pod only once the old one has stopped, so two servers
    // never use the volume at once.
    serviceName: svc.metadata.name
    selector: {
      matchLabels: labels
    }
    template: {
      metadata: {
        labels: union(labels, {
          'radapp.io/application': context.application == null ? '' : context.application.name
        })
      }
      spec: union(
        empty(imagePullSecretName) ? {} : { imagePullSecrets: [ { name: imagePullSecretName } ] },
        {
          terminationGracePeriodSeconds: 60
          // The image's entrypoint runs the server directly when it doesn't start as root. The group
          // lets it read the key and the administrator's files, which PostgreSQL accepts when root
          // owns them with mode 0640.
          securityContext: {
            runAsNonRoot: true
            runAsUser: postgresUserId
            runAsGroup: postgresUserId
            fsGroup: postgresUserId
            seccompProfile: { type: 'RuntimeDefault' }
          }
          volumes: concat([
            { name: 'data', persistentVolumeClaim: { claimName: data.metadata.name } }
            { name: 'config', configMap: { name: config.metadata.name } }
            { name: 'admin', secret: { secretName: admin.metadata.name, defaultMode: 288 } }
            { name: 'run', emptyDir: {} }
            { name: 'tmp', emptyDir: {} }
          ], useTls ? [
            { name: 'tls', secret: { secretName: tlsSecretName, defaultMode: 416 } }
          ] : [])
          containers: [
            {
              name: 'postgres'
              image: image
              args: serverArgs
              ports: [ { containerPort: postgresPort } ]
              env: [
                {
                  name: 'POSTGRES_USER'
                  valueFrom: { secretKeyRef: { name: admin.metadata.name, key: 'username' } }
                }
                { name: 'POSTGRES_PASSWORD_FILE', value: '${adminDir}/password' }
                { name: 'PGDATA', value: '/var/lib/postgresql/data/pgdata' }
                // Text is ordered by ICU, the same on every image, rather than by the C library.
                { name: 'POSTGRES_INITDB_ARGS', value: '--encoding=UTF8 --lc-collate=${locale} --lc-ctype=${locale} --locale-provider=icu --icu-locale=${icuLocale}' }
              ]
              volumeMounts: concat([
                { name: 'data', mountPath: '/var/lib/postgresql/data' }
                { name: 'config', mountPath: '/etc/postgres-config', readOnly: true }
                adminMount
                socketMount
                { name: 'tmp', mountPath: '/tmp' }
              ], tlsMount)
              securityContext: containerSecurityContext
              resources: {
                requests: { cpu: '100m', memory: '256Mi' }
                limits: { memory: '1Gi' }
              }
              readinessProbe: {
                exec: {
                  command: [ 'sh', '-c', 'pg_isready -h ${socketDir} -U "$POSTGRES_USER"' ]
                }
                initialDelaySeconds: 10
                periodSeconds: 10
              }
            }
            {
              name: 'apply-admin'
              image: image
              command: [ 'sh', '-c', applyScript ]
              volumeMounts: concat([
                { name: 'config', mountPath: '/etc/postgres-config', readOnly: true }
                adminMount
                socketMount
              ], tlsMount)
              securityContext: containerSecurityContext
              resources: {
                requests: { cpu: '5m', memory: '16Mi' }
                limits: { memory: '64Mi' }
              }
            }
          ]
        }
      )
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: uniqueName
  }
  spec: {
    type: 'ClusterIP'
    selector: labels
    ports: [
      {
        name: 'postgres'
        port: postgresPort
        #disable-next-line BCP036
        targetPort: postgresPort
      }
    ]
  }
}

output result object = {
  // cert-manager leaves the certificate's Secret behind when the Certificate is deleted, so it is
  // listed too, and the private key goes with the resource.
  resources: concat([
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Service/${svc.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/apps/StatefulSet/${postgres.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/PersistentVolumeClaim/${data.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${admin.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/ConfigMap/${config.metadata.name}'
  ], useTls ? [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/cert-manager.io/Certificate/${tlsSecretName}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${tlsSecretName}'
  ] : [])
  values: {
    host: '${svc.metadata.name}.${namespace}.svc.cluster.local'
    port: postgresPort
    database: database
    tls: useTls ? 'required' : 'optional'
  }
}
