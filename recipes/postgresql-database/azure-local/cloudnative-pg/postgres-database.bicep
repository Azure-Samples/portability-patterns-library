// Recipe: Radius.Data/postgreSqlDatabases -> a PostgreSQL cluster run by the CloudNativePG operator.
//
// Used by the Azure Local environment, where the workload must not depend on Azure Database for
// PostgreSQL, when the Recipe Pack's availability is 'high'; with 'standard' it uses
// ../postgres instead. The Azure environment binds the same Resource Type to a Flexible
// Server.
//
// The Recipe declares a CloudNativePG Cluster; the operator, installed once per cluster by the
// platform (scripts/infra/azurelocal/provision-operators.ps1), does the rest: one primary and
// streaming replicas on separate nodes, automatic failover, rolling updates and certificate reloads.
// Applications connect to the read-write Service, which always points at the current primary.
//
// The administrator account from the resource is for the database setup job only, as 'sa' is on the
// SQL Server container: it owns the database and is a superuser. Applications sign in as their own
// least-privilege roles, which that job creates. A changed administrator password is applied by the
// operator. With an object store, the write-ahead log is archived continuously and a base backup is
// taken daily, so the database can be restored to any point in the retention window.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Tag of the CloudNativePG PostgreSQL image to deploy.')
param tag string = '17.11-standard-trixie'

@description('''
Registry serving the PostgreSQL image. On Azure Local this is the in-cluster connected registry, so
a restarted pod still finds its image while the link to Azure is down.
''')
param imageRegistry string = 'ghcr.io'

@description('Repository holding the PostgreSQL image within the registry.')
param imageRepository string = 'cloudnative-pg/postgresql'

@description('Name of an existing Kubernetes image pull secret in the application namespace.')
param imagePullSecretName string = ''

@description('PostgreSQL instances: one primary, the rest replicas that take over if it fails. The operator spreads them across nodes.')
@minValue(1)
param instances int = 3

@description('cert-manager ClusterIssuer that issues the server certificate. Empty uses a certificate the operator signs itself, which clients can\'t verify.')
param certificateIssuer string = ''

@description('Size of each instance\'s persistent volume.')
param storageSize string = '10Gi'

@description('Storage class of those volumes. Empty uses the cluster default.')
param storageClassName string = ''

@description('HTTPS endpoint of the S3-compatible store that backups go to, for example https://seaweedfs-s3.object-store.svc.cluster.local:8443. Empty takes no backups.')
param backupEndpoint string = ''

@description('Bucket on that endpoint for this namespace\'s backups.')
param backupBucket string = ''

@description('Secret in the application namespace with the bucket\'s credentials, keys ACCESS_KEY_ID and ACCESS_SECRET_KEY, and the store\'s CA, key ca.crt.')
param backupCredentialsSecretName string = ''

@description('How long backups are kept: the window the database can be restored to any point in.')
param backupRetention string = '30d'

@description('When the daily base backup runs: a six-field cron expression, seconds first.')
param backupSchedule string = '0 0 2 * * *'

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var uniqueName = 'postgres-${uniqueString(context.resource.id)}'
var namespace = context.runtime.kubernetes.namespace
var postgresPort = 5432
var useTls = !empty(certificateIssuer)
var useBackups = !empty(backupEndpoint)
var database = context.resource.properties.?database ?? 'postgres_db'
var adminUsername = context.resource.properties.username
var tlsSecretName = '${uniqueName}-tls'
var objectStoreName = '${uniqueName}-backups'
var barmanPlugin = 'barman-cloud.cloudnative-pg.io'

// The administrator's credentials, in the form the operator reads. When the password changes, the
// operator sets it in the database.
resource admin 'core/Secret@v1' = {
  metadata: {
    name: '${uniqueName}-admin'
    labels: {
      'cnpg.io/reload': 'true'
    }
  }
  type: 'kubernetes.io/basic-auth'
  stringData: {
    username: adminUsername
    password: context.resource.properties.password
  }
}

// The server's certificate, from the site CA, naming every Service the operator creates. The
// operator reloads it when cert-manager renews it.
#disable-next-line BCP081
resource certificate 'cert-manager.io/Certificate@v1' = if (useTls) {
  metadata: {
    name: tlsSecretName
  }
  spec: {
    secretName: tlsSecretName
    commonName: '${uniqueName}-rw.${namespace}.svc'
    dnsNames: flatten(map([ 'rw', 'r', 'ro' ], service => [
      '${uniqueName}-${service}'
      '${uniqueName}-${service}.${namespace}'
      '${uniqueName}-${service}.${namespace}.svc'
      '${uniqueName}-${service}.${namespace}.svc.cluster.local'
    ]))
    usages: [ 'server auth' ]
    duration: '2160h'
    renewBefore: '720h'
    privateKey: {
      algorithm: 'RSA'
      size: 2048
      rotationPolicy: 'Always'
    }
    issuerRef: {
      kind: 'ClusterIssuer'
      name: certificateIssuer
    }
  }
}

// Where the write-ahead log and base backups go, and how long they're kept.
#disable-next-line BCP081
resource objectStore 'barmancloud.cnpg.io/ObjectStore@v1' = if (useBackups) {
  metadata: {
    name: objectStoreName
  }
  spec: {
    configuration: {
      destinationPath: 's3://${backupBucket}/'
      endpointURL: backupEndpoint
      // The store's certificate is checked against this CA, so backups only ever go to it.
      endpointCA: {
        name: backupCredentialsSecretName
        key: 'ca.crt'
      }
      s3Credentials: {
        accessKeyId: {
          name: backupCredentialsSecretName
          key: 'ACCESS_KEY_ID'
        }
        secretAccessKey: {
          name: backupCredentialsSecretName
          key: 'ACCESS_SECRET_KEY'
        }
      }
      wal: {
        compression: 'gzip'
      }
      data: {
        compression: 'gzip'
      }
    }
    retentionPolicy: backupRetention
    // Newer AWS clients add checksums that some S3-compatible stores reject.
    instanceSidecarConfiguration: {
      env: [
        { name: 'AWS_REQUEST_CHECKSUM_CALCULATION', value: 'when_required' }
        { name: 'AWS_RESPONSE_CHECKSUM_VALIDATION', value: 'when_required' }
      ]
    }
  }
}

#disable-next-line BCP081
resource postgres 'postgresql.cnpg.io/Cluster@v1' = {
  dependsOn: [ certificate, objectStore ]
  metadata: {
    name: uniqueName
  }
  spec: union({
    instances: instances
    imageName: '${imageRegistry}/${imageRepository}:${tag}'
    // The operator's own pods (the instances, and the jobs that create them) carry these labels,
    // which the application's network policies select on.
    inheritedMetadata: {
      labels: {
        app: 'postgres'
        resource: context.resource.name
        'radapp.io/application': context.application == null ? '' : context.application.name
      }
    }
    storage: union({
      size: storageSize
    }, empty(storageClassName) ? {} : { storageClass: storageClassName })
    // Each instance on a different node where there are enough of them.
    affinity: {
      enablePodAntiAffinity: true
      topologyKey: 'kubernetes.io/hostname'
      podAntiAffinityType: 'preferred'
    }
    resources: {
      requests: { cpu: '100m', memory: '256Mi' }
      limits: { memory: '1Gi' }
    }
    bootstrap: {
      initdb: {
        database: database
        owner: adminUsername
        secret: { name: admin.metadata.name }
      }
    }
    // A superuser, so the setup job can create and change the applications' roles. The operator
    // revokes role memberships it wasn't told about, and a role that merely may create roles needs
    // one (ADMIN on each role it created) to change that role's password later.
    managed: {
      roles: [
        {
          name: adminUsername
          ensure: 'present'
          login: true
          superuser: true
          passwordSecret: { name: admin.metadata.name }
        }
      ]
    }
    enableSuperuserAccess: false
    // A stopping primary waits this long for clients to disconnect before it shuts down and a replica
    // takes over. The default, 180 seconds, keeps a pooled client's database down for minutes.
    smartShutdownTimeout: 15
  },
  // A commit returns only once a replica has it too, so a failover loses no committed transaction.
  // 'preferred': while no replica is available, commits don't wait, so writes carry on.
  instances > 1 ? {
    postgresql: {
      synchronous: {
        method: 'any'
        number: 1
        dataDurability: 'preferred'
      }
    }
  } : {},
  empty(imagePullSecretName) ? {} : { imagePullSecrets: [ { name: imagePullSecretName } ] },
  useTls ? {
    certificates: {
      serverTLSSecret: tlsSecretName
      serverCASecret: tlsSecretName
    }
  } : {},
  useBackups ? {
    plugins: [
      {
        name: barmanPlugin
        isWALArchiver: true
        parameters: { barmanObjectName: objectStoreName }
      }
    ]
  } : {})
}

// A base backup every day, and one as soon as the cluster is up.
#disable-next-line BCP081
resource scheduledBackup 'postgresql.cnpg.io/ScheduledBackup@v1' = if (useBackups) {
  metadata: {
    name: '${uniqueName}-daily'
  }
  spec: {
    schedule: backupSchedule
    immediate: true
    backupOwnerReference: 'self'
    cluster: {
      name: postgres.metadata.name
    }
    method: 'plugin'
    pluginConfiguration: {
      name: barmanPlugin
    }
  }
}

output result object = {
  // The operator's Services, pods and volumes belong to the Cluster, so deleting it removes them.
  resources: concat([
    '/planes/kubernetes/local/namespaces/${namespace}/providers/postgresql.cnpg.io/Cluster/${uniqueName}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${admin.metadata.name}'
  ], useTls ? [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/cert-manager.io/Certificate/${tlsSecretName}'
  ] : [], useBackups ? [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/barmancloud.cnpg.io/ObjectStore/${objectStoreName}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/postgresql.cnpg.io/ScheduledBackup/${uniqueName}-daily'
  ] : [])
  values: {
    // The read-write Service, which follows the primary through a failover.
    host: '${uniqueName}-rw.${namespace}.svc.cluster.local'
    port: postgresPort
    database: database
    // The operator always encrypts connections; clients verify the server only when its
    // certificate comes from a CA they trust.
    tls: useTls ? 'required' : 'optional'
  }
}
