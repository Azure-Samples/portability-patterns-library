// Recipe: Radius.Data/postgreSqlDatabases -> Azure Database for PostgreSQL flexible server.
//
// The same Resource Type is backed by a PostgreSQL container on Azure Local. Switching environments
// changes the Recipe, never the application.
//
// Only Microsoft Entra ID authentication is enabled. The Entra administrator is a dedicated
// database-administrator identity, used only by the database setup job, which creates a
// least-privilege role for each service's managed identity. Services sign in with Workload
// Identity and no password. The Resource Type's username and password are not used.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Azure region for the server. Defaults to the resource group location.')
param location string = resourceGroup().location

@description('Object ID of the database-administrator managed identity, set as the Entra administrator.')
param administratorPrincipalId string

@description('Name of that managed identity. It is also the administrator role name in PostgreSQL.')
param administratorName string

@description('Entra ID tenant that the administrator principal belongs to.')
param tenantId string = subscription().tenantId

@description('Compute tier and size.')
param skuTier string = 'Burstable'
param skuName string = 'Standard_B1ms'

@description('PostgreSQL major version: the same as the Azure Local Recipes.')
param version string = '17'

@description('''
Collation and character classification of the database. Azure creates databases with the C
library's locales only; the Azure Local Recipes order text with the matching ICU locale (en-US).
''')
param collation string = 'en_US.utf8'

@description('Storage size in GB.')
param storageSizeGB int = 32

@description('Days of automatic backups to keep.')
param backupRetentionDays int = 7

@description('Subnet for a private endpoint to the server. Empty keeps public access and creates no endpoint.')
param privateEndpointSubnetId string = ''

@description('Private DNS zone (privatelink.postgres.database.azure.com) the endpoint registers in. Required with privateEndpointSubnetId.')
param privateDnsZoneId string = ''

@description('Region of the private endpoint: the virtual network\'s, which may differ from the server\'s.')
param privateEndpointLocation string = location

var usePrivateEndpoint = !empty(privateEndpointSubnetId)

var radiusTags = {
  'radapp.io-application': context.application == null ? '' : context.application.name
  'radapp.io-environment': context.environment.name
  'radapp.io-resource': context.resource.name
}

var database = context.resource.properties.?database ?? 'postgres_db'

// Server names are globally unique and lowercase; the resource group and the location are part of
// the hash for the same reasons as in the Azure SQL Recipe: the Radius resource ID is the same in
// every deployment, and a name is bound to the region of its first creation attempt.
var serverName = take('psql-${uniqueString(resourceGroup().id, context.resource.id, location)}', 63)

resource server 'Microsoft.DBforPostgreSQL/flexibleServers@2025-08-01' = {
  name: serverName
  location: location
  sku: {
    name: skuName
    tier: skuTier
  }
  properties: {
    version: version
    storage: {
      storageSizeGB: storageSizeGB
      autoGrow: 'Enabled'
    }
    backup: {
      backupRetentionDays: backupRetentionDays
      geoRedundantBackup: 'Disabled'
    }
    authConfig: {
      activeDirectoryAuth: 'Enabled'
      passwordAuth: 'Disabled'
      tenantId: tenantId
    }
    network: {
      publicNetworkAccess: usePrivateEndpoint ? 'Disabled' : 'Enabled'
    }
    highAvailability: {
      mode: 'Disabled'
    }
  }
  tags: radiusTags
}

resource administrator 'Microsoft.DBforPostgreSQL/flexibleServers/administrators@2025-08-01' = {
  parent: server
  name: administratorPrincipalId
  properties: {
    principalType: 'ServicePrincipal'
    principalName: administratorName
    tenantId: tenantId
  }
}

resource postgresDatabase 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2025-08-01' = {
  parent: server
  name: database
  dependsOn: [ administrator ]
  properties: {
    charset: 'UTF8'
    collation: collation
  }
}

// Without a private endpoint: allows other Azure services, including the AKS cluster's egress, to
// reach the server. Set privateEndpointSubnetId for production.
resource allowAzureServices 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2025-08-01' = if (!usePrivateEndpoint) {
  parent: server
  name: 'AllowAllAzureServicesAndResourcesWithinAzureIps'
  dependsOn: [ postgresDatabase ]
  properties: {
    startIpAddress: '0.0.0.0'
    endIpAddress: '0.0.0.0'
  }
}

resource privateEndpoint 'Microsoft.Network/privateEndpoints@2024-05-01' = if (usePrivateEndpoint) {
  name: 'pe-${serverName}'
  location: privateEndpointLocation
  dependsOn: [ postgresDatabase ]
  properties: {
    subnet: {
      id: privateEndpointSubnetId
    }
    privateLinkServiceConnections: [
      {
        name: 'postgresqlServer'
        properties: {
          privateLinkServiceId: server.id
          groupIds: [
            'postgresqlServer'
          ]
        }
      }
    ]
  }
  tags: radiusTags
}

resource privateDnsZoneGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2024-05-01' = if (usePrivateEndpoint) {
  parent: privateEndpoint
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'postgres'
        properties: {
          privateDnsZoneId: privateDnsZoneId
        }
      }
    ]
  }
}

output result object = {
  resources: concat([
    server.id
    postgresDatabase.id
  ], usePrivateEndpoint ? [ privateEndpoint.id ] : [])
  values: {
    host: server.properties.fullyQualifiedDomainName
    port: 5432
    database: database
    tls: 'required'
  }
}
