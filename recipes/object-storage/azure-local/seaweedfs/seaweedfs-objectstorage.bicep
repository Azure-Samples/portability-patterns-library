// Recipe: Radius.Storage/objectStorage -> a bucket in the site's S3-compatible object store.
//
// Used by the Azure Local environment. The store, SeaweedFS, runs once per cluster
// (scripts/infra/azurelocal/provision-object-store.ps1), the way the operators do, so this Recipe
// deploys nothing: it names the bucket and says where the store is. The bucket is named
// <namespace>.<containerName>: a namespace name can't contain a dot, so no namespace's buckets share
// a prefix with another's, nor with the backup buckets (postgres-<namespace>). The S3 keys aren't
// the Recipe's: the platform issues them per namespace, limited to buckets '<namespace>.*', and the
// Recipe Pack gives them only to containers connected to this resource. The application creates the
// bucket once, at startup, if it is missing (the namespace's keys allow that), and never recreates it
// on a write. Deleting the resource leaves the bucket and its objects in place.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('HTTPS endpoint of the site\'s S3 object store, for example https://seaweedfs-s3.object-store.svc.cluster.local:8443. Clients verify it against the site CA the Recipe Pack gives every container.')
param endpoint string = ''

var namespace = context.runtime.kubernetes.namespace
var bucket = toLower('${namespace}.${context.resource.properties.?containerName ?? 'data'}')

output result object = {
  resources: []
  values: {
    endpoint: !startsWith(endpoint, 'https://')
      ? fail('No HTTPS object store endpoint. Run scripts/infra/azurelocal/provision-object-store.ps1 and set the Recipe Pack\'s objectStoreEndpoint.')
      : endpoint
    // S3 bucket names are 3 to 63 lowercase letters, digits, dots and hyphens.
    containerName: length(bucket) > 63 ? fail('Bucket name \'${bucket}\' is longer than 63 characters; use a shorter containerName.') : bucket
  }
}
