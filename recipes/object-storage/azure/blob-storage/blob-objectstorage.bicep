// Recipe: Radius.Storage/objectStorage -> Azure Storage account + blob container.
//
// Shared-key access is disabled on the account, so the only way in is Entra ID. The Recipe creates
// the container; the managed identities of the services that write to it are granted Storage Blob
// Data Contributor on this container only, and authenticate with Workload Identity, so they write
// to it but never create or recreate it. No connection string is emitted.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Azure region for the storage account. Defaults to the resource group location.')
param location string = resourceGroup().location

@description('Principal (object) IDs of the managed identities granted read and write access to the container.')
param contributorPrincipalIds array

@description('Storage account replication SKU.')
@allowed([
  'Standard_LRS'
  'Standard_ZRS'
  'Standard_GRS'
  'Standard_RAGRS'
])
param sku string = 'Standard_LRS'

@description('Subnet for a private endpoint to the blob service. Empty keeps public access and creates no endpoint.')
param privateEndpointSubnetId string = ''

@description('Private DNS zone (privatelink.blob...) the endpoint registers in. Required with privateEndpointSubnetId.')
param privateDnsZoneId string = ''

@description('Region of the private endpoint: the virtual network\'s.')
param privateEndpointLocation string = location

var usePrivateEndpoint = !empty(privateEndpointSubnetId)

var radiusTags = {
  'radapp.io-application': context.application == null ? '' : context.application.name
  'radapp.io-environment': context.environment.name
  'radapp.io-resource': context.resource.name
}

var containerName = context.resource.properties.?containerName ?? 'data'

// Storage account names are globally unique, lowercase alphanumeric, 3-24 characters. The resource
// group is part of the hash because the Radius resource ID is the same in every deployment of an app.
var accountName = take('st${uniqueString(resourceGroup().id, context.resource.id)}', 24)

// Built-in role definition ID for Storage Blob Data Contributor.
var blobDataContributorRoleId = 'ba92f5b4-2d11-453d-a403-e96b0029c9fe'

resource storageAccount 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: accountName
  location: location
  sku: {
    name: sku
  }
  kind: 'StorageV2'
  properties: {
    accessTier: 'Hot'
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
    // Force Entra ID auth; this is what makes the managed identity path mandatory.
    allowSharedKeyAccess: false
    allowBlobPublicAccess: false
    // With a private endpoint, only the virtual network reaches the account's data.
    publicNetworkAccess: usePrivateEndpoint ? 'Disabled' : 'Enabled'
  }
  tags: radiusTags
}

resource blobService 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' = {
  parent: storageAccount
  name: 'default'
}

resource container 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = {
  parent: blobService
  name: containerName
  properties: {
    publicAccess: 'None'
  }
}

resource blobContributorAssignments 'Microsoft.Authorization/roleAssignments@2022-04-01' = [for principalId in contributorPrincipalIds: {
  scope: container
  name: guid(container.id, principalId, blobDataContributorRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', blobDataContributorRoleId)
    principalId: principalId
    principalType: 'ServicePrincipal'
  }
}]

resource privateEndpoint 'Microsoft.Network/privateEndpoints@2024-05-01' = if (usePrivateEndpoint) {
  name: 'pe-${accountName}-blob'
  location: privateEndpointLocation
  properties: {
    subnet: {
      id: privateEndpointSubnetId
    }
    privateLinkServiceConnections: [
      {
        name: 'blob'
        properties: {
          privateLinkServiceId: storageAccount.id
          groupIds: [
            'blob'
          ]
        }
      }
    ]
  }
  tags: radiusTags
}

resource privateDnsZoneGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2024-05-01' = if (usePrivateEndpoint) {
  parent: privateEndpoint
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'blob'
        properties: {
          privateDnsZoneId: privateDnsZoneId
        }
      }
    ]
  }
}

output result object = {
  resources: concat([
    storageAccount.id
    container.id
  ], usePrivateEndpoint ? [ privateEndpoint.id ] : [])
  values: {
    accountName: accountName
    endpoint: storageAccount.properties.primaryEndpoints.blob
    containerName: containerName
  }
}
