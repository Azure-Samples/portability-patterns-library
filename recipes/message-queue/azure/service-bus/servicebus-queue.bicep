// Recipe: Portability.Messaging/messageQueues -> Azure Service Bus queue.
//
// Creates a Service Bus namespace and queue, then grants each service's federated user-assigned
// managed identity only the data-plane role it needs on this queue: send to the publishers, receive
// to the consumers. No SAS keys or connection strings are emitted: the services authenticate with
// the workload identities the platform attaches to their pods.
//
// The identities and their federated identity credentials are created by the platform; their
// principal IDs come from the Recipe Pack.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Azure region for the Service Bus namespace. Defaults to the resource group location.')
param location string = resourceGroup().location

@description('Principal (object) IDs of the managed identities allowed to send to the queue.')
param senderPrincipalIds array

@description('Principal (object) IDs of the managed identities allowed to receive from the queue.')
param receiverPrincipalIds array

@description('Action group notified when a message is dead-lettered. Empty creates no alert.')
param alertActionGroupId string = ''

@description('Service Bus SKU. Standard is the minimum that supports queues with sessions and topics.')
@allowed([
  'Basic'
  'Standard'
  'Premium'
])
param sku string = 'Standard'

var queueName = context.resource.properties.?queueName ?? context.resource.name
var maxDeliveryCount = context.resource.properties.?maxDeliveryCount ?? 10

// Service Bus namespace names are globally unique and limited to 50 characters. The resource group
// is part of the hash because the Radius resource ID is the same in every deployment of an app.
var namespaceName = take('sb-${uniqueString(resourceGroup().id, context.resource.id)}', 50)

// Built-in role definition IDs for the Service Bus data plane.
var dataSenderRoleId = '69a216fc-b8fb-44d8-bc22-1f3c2cd27a39'
var dataReceiverRoleId = '4f6d3b9b-027b-4f4c-9142-0e5a2a2247e0'

resource serviceBusNamespace 'Microsoft.ServiceBus/namespaces@2022-10-01-preview' = {
  name: namespaceName
  location: location
  sku: {
    name: sku
    tier: sku
  }
  properties: {
    disableLocalAuth: true
    minimumTlsVersion: '1.2'
    publicNetworkAccess: 'Enabled'
  }
  tags: {
    'radapp.io-application': context.application == null ? '' : context.application.name
    'radapp.io-environment': context.environment.name
    'radapp.io-resource': context.resource.name
  }
}

resource queue 'Microsoft.ServiceBus/namespaces/queues@2022-10-01-preview' = {
  parent: serviceBusNamespace
  name: queueName
  properties: {
    maxDeliveryCount: maxDeliveryCount
    lockDuration: 'PT1M'
    defaultMessageTimeToLive: 'P14D'
    deadLetteringOnMessageExpiration: true
    enablePartitioning: false
  }
}

resource senderAssignments 'Microsoft.Authorization/roleAssignments@2022-04-01' = [for principalId in senderPrincipalIds: {
  scope: queue
  name: guid(queue.id, principalId, dataSenderRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', dataSenderRoleId)
    principalId: principalId
    principalType: 'ServicePrincipal'
  }
}]

resource receiverAssignments 'Microsoft.Authorization/roleAssignments@2022-04-01' = [for principalId in receiverPrincipalIds: {
  scope: queue
  name: guid(queue.id, principalId, dataReceiverRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', dataReceiverRoleId)
    principalId: principalId
    principalType: 'ServicePrincipal'
  }
}]

// A message in the dead-letter queue failed every delivery attempt, so it needs someone to look at it.
resource deadLetterAlert 'Microsoft.Insights/metricAlerts@2018-03-01' = if (!empty(alertActionGroupId)) {
  name: '${namespaceName}-${queueName}-dead-letter'
  location: 'global'
  properties: {
    description: 'A message in queue ${queueName} was dead-lettered.'
    severity: 2
    enabled: true
    scopes: [ serviceBusNamespace.id ]
    evaluationFrequency: 'PT5M'
    windowSize: 'PT15M'
    criteria: {
      'odata.type': 'Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria'
      allOf: [
        {
          name: 'dead-lettered'
          criterionType: 'StaticThresholdCriterion'
          metricNamespace: 'Microsoft.ServiceBus/namespaces'
          metricName: 'DeadletteredMessages'
          dimensions: [
            {
              name: 'EntityName'
              operator: 'Include'
              values: [ queueName ]
            }
          ]
          operator: 'GreaterThan'
          threshold: 0
          timeAggregation: 'Maximum'
        }
      ]
    }
    actions: [
      { actionGroupId: alertActionGroupId }
    ]
  }
}

output result object = {
  resources: concat([
    serviceBusNamespace.id
    queue.id
  ], empty(alertActionGroupId) ? [] : [ deadLetterAlert.id ])
  values: {
    provider: 'servicebus'
    queueName: queueName
    endpoint: '${namespaceName}.servicebus.windows.net'
    tls: 'required'
  }
}
