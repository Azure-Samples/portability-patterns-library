// Recipe: Portability.Messaging/messageQueues -> a RabbitMQ cluster run by the RabbitMQ Cluster Operator.
//
// Used by the Azure Local environment, where the workload must not depend on Azure Service Bus, when
// the Recipe Pack's availability is 'high'; with 'standard' it uses ../rabbitmq instead.
// Publishes provider = 'rabbitmq' so the application can select its RabbitMQ client at startup.
//
// The Recipe declares a RabbitmqCluster, plus the queue, its dead-letter queue and the policy
// between them as Messaging Topology Operator resources. The operators, installed once per cluster
// by the platform (scripts/infra/azurelocal/provision-operators.ps1), do the rest. With three nodes
// the queues are quorum queues replicated to every node, so losing one node loses no message and
// the queue stays available. Each node keeps its data on its own persistent volume, and a
// disruption budget keeps a drain from taking more than one node at a time.
//
// With a certificate issuer, nothing reaches or leaves the brokers in the clear: clients connect over
// TLS only, to a certificate from the site CA, and the nodes replicate to each other over mutual TLS
// with certificates the cert-manager CSI driver issues to each pod.
//
// Workloads always authenticate with a token from the site's identity provider, so this Recipe hands
// the application no credentials. The cluster's default user, the administrator the operators sign
// in as, comes from a Secret the platform creates; it serves the management interface only and can't
// open messaging connections.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Tag of the rabbitmq container image to deploy.')
param tag string = '4.3.7-management-alpine'

@description('''
Registry serving the RabbitMQ image. Empty means Docker Hub. On Azure Local this is the in-cluster
connected registry, so a restarted pod still finds its image while the link to Azure is down.
''')
param imageRegistry string = ''

@description('Repository holding the RabbitMQ image within the registry.')
param imageRepository string = 'rabbitmq'

@description('''
Name of an existing Kubernetes image pull secret in the application namespace. Required when the
registry needs authentication: kubelet pulls this image, and it uses neither the Radius control
plane's registry credentials nor the application's own pull secret.
''')
param imagePullSecretName string = ''

@description('RabbitMQ nodes. Three keeps the queues available, with no message lost, when one node fails.')
@minValue(1)
param replicas int = 3

@description('''
Issuer URL of the identity provider, for example `https://keycloak.example/realms/my-realm`.
Workloads authenticate to the broker with a token from it. Required.
''')
param oauthIssuer string

@description('Audience the broker requires in a token. Must match the audience the issuer stamps.')
param oauthResourceServerId string = 'rabbitmq'

@description('Claim the broker reads permissions from, for identity providers such as Keycloak that cannot express them as scopes.')
param oauthScopesKey string = 'rabbitmq_scopes'

@description('Existing Secret holding the issuer certificate authority under the key `ca.crt`.')
param oauthCaSecretName string = ''

@description('''
Existing Secret in the application namespace with the broker administrator's credentials: keys
`username`, `password` and `default_user.conf` ("default_user = <username>" and
"default_pass = <password>" lines). The operator makes it the cluster's default user, and the
Messaging Topology Operator signs in with it.
''')
param adminCredentialsSecretName string

// How a workload obtains its token is not this Recipe's concern: the Recipe Pack gives every pod
// its identity (token file, client and token endpoint). This Recipe only configures the broker to
// accept tokens from the issuer.

@description('''
cert-manager ClusterIssuer, a CA issuer such as the site CA, for the brokers' certificates. Clients
then connect over TLS only, and the nodes talk to each other over mutual TLS, which needs the
cert-manager CSI driver. Empty runs without TLS.
''')
param certificateIssuer string = ''

@description('Size of each node\'s persistent volume.')
param storageSize string = '2Gi'

@description('Storage class of those volumes. Empty uses the cluster default.')
param storageClassName string = ''

var image = empty(imageRegistry) ? '${imageRepository}:${tag}' : '${imageRegistry}/${imageRepository}:${tag}'

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var uniqueName = 'rabbitmq-${uniqueString(context.resource.id)}'
var namespace = context.runtime.kubernetes.namespace
var queueName = context.resource.properties.?queueName ?? context.resource.name
var useTls = !empty(certificateIssuer)
var amqpPort = useTls ? 5671 : 5672
var tlsSecretName = '${uniqueName}-tls'
// Prometheus reaches each node by its address, so it checks the certificate for this name, which
// every RabbitMQ certificate in the namespace carries, rather than the cluster's own.
var metricsServerName = 'metrics.rabbitmq.${namespace}'
var issuer = empty(oauthIssuer)
  ? fail('oauthIssuer is required: workloads authenticate to RabbitMQ with a token from the site\'s identity provider.')
  : oauthIssuer
// Service Bus dead-letters a message on its maxDeliveryCount-th delivery. A quorum queue does so
// once a message has been returned more than delivery-limit times, one delivery later, so the limit
// is one less.
var maxDeliveryCount = context.resource.properties.?maxDeliveryCount ?? 10
var deliveryLimit = max(maxDeliveryCount - 1, 0)
var deadLetterQueueName = '${queueName}.dead-letter'

// The policy matches the queue by regular expression, and a queue name may contain any character,
// so every regular expression metacharacter is escaped. The backslash goes first, or it would
// escape the escapes.
var queueNamePattern = reduce(
  [ '\\', '.', '+', '*', '?', '(', ')', '[', ']', '{', '}', '^', '$', '|' ],
  queueName,
  (escaped, character) => replace(escaped, character, '\\${character}'))

// Queues are quorum queues by default. Tokens first; the internal backend, second, holds only the
// administrator, for the operators and the management interface.
var additionalConfig = join(concat([
  'default_queue_type = quorum'
  'auth_backends.1 = rabbit_auth_backend_oauth2'
  'auth_backends.2 = internal'
  'auth_oauth2.resource_server_id = ${oauthResourceServerId}'
  'auth_oauth2.issuer = ${issuer}'
  'auth_oauth2.additional_scopes_key = ${oauthScopesKey}'
  'auth_oauth2.preferred_username_claims.1 = preferred_username'
], empty(oauthCaSecretName) ? [] : [
  'auth_oauth2.https.cacertfile = /etc/rabbitmq/oauth-ca/ca.crt'
]), '\n')

// Once a node is up, the administrator's connection limit of zero bars it from AMQP, so it can't get
// around the permissions each workload's token carries. The operators use the management interface
// and the CLI, which don't count as connections. await_startup fails at once until the node's runtime
// is up, so it is retried, for up to five minutes; a node that never starts still fails the pod.
// Joined with '\n' rather than written as a multi-line string, which would keep the file's line
// endings: a checkout with CRLF endings would break the shell script.
var startupScript = join([
  'set -e'
  'attempt=0'
  'until rabbitmqctl -q await_startup --timeout 600 >/dev/null 2>&1; do'
  '  attempt=$((attempt + 1))'
  '  if [ "$attempt" -ge 60 ]; then echo "RabbitMQ did not start" >&2; exit 1; fi'
  '  sleep 5'
  'done'
  'rabbitmqctl -q set_user_limits "$ADMIN_USERNAME" \'{"max-connections": 0}\''
], '\n')

// What the operator's StatefulSet gets on top of its defaults, which already run every container as
// a non-root user with no privileges, all capabilities dropped and a read-only root file system: the
// labels the application's network policies select on, the hook above, with TLS the group that reads
// the inter-node certificates and, with an identity provider CA, that CA. The operator merges this
// into its own pod template by container and volume name.
var mountOAuthCa = !empty(oauthCaSecretName)
var rabbitmqContainerOverride = union({
  name: 'rabbitmq'
  env: [
    {
      name: 'ADMIN_USERNAME'
      valueFrom: { secretKeyRef: { name: adminCredentialsSecretName, key: 'username' } }
    }
  ]
  lifecycle: {
    postStart: {
      exec: {
        command: [ 'sh', '-c', startupScript ]
      }
    }
  }
}, mountOAuthCa ? {
  volumeMounts: [
    {
      name: 'oauth-ca'
      mountPath: '/etc/rabbitmq/oauth-ca'
      readOnly: true
    }
  ]
} : {})
var podSpecOverride = union(useTls ? {
  // The inter-node certificates are readable by group 999, the rabbitmq user's group in the
  // Ubuntu-based image. The Alpine image has no such entry, so the process gets the group this way.
  securityContext: {
    supplementalGroups: [ 999 ]
  }
} : {}, {
  containers: [ rabbitmqContainerOverride ]
}, mountOAuthCa ? {
  volumes: [
    {
      name: 'oauth-ca'
      secret: {
        secretName: oauthCaSecretName
        items: [ { key: 'ca.crt', path: 'ca.crt' } ]
      }
    }
  ]
} : {})
var podOverride = {
  metadata: {
    labels: {
      app: 'rabbitmq'
      resource: context.resource.name
      'radapp.io/application': context.application == null ? '' : context.application.name
    }
  }
  spec: podSpecOverride
}

// The brokers' certificate for clients, from the site CA, naming the client Service. RabbitMQ
// re-reads it when cert-manager renews it.
#disable-next-line BCP081
resource certificate 'cert-manager.io/Certificate@v1' = if (useTls) {
  metadata: {
    name: tlsSecretName
  }
  spec: {
    secretName: tlsSecretName
    commonName: '${uniqueName}.${namespace}.svc'
    dnsNames: [
      uniqueName
      '${uniqueName}.${namespace}'
      '${uniqueName}.${namespace}.svc'
      '${uniqueName}.${namespace}.svc.cluster.local'
      metricsServerName
    ]
    usages: [ 'server auth' ]
    duration: '2160h'
    renewBefore: '720h'
    privateKey: {
      algorithm: 'RSA'
      size: 2048
      rotationPolicy: 'Always'
    }
    issuerRef: {
      kind: 'ClusterIssuer'
      name: certificateIssuer
    }
  }
}

#disable-next-line BCP081
resource rabbitmq 'rabbitmq.com/RabbitmqCluster@v1beta1' = {
  dependsOn: [ certificate ]
  metadata: {
    name: uniqueName
  }
  spec: union({
    replicas: replicas
    image: image
    persistence: union({
      storage: storageSize
    }, empty(storageClassName) ? {} : { storageClassName: storageClassName })
    resources: {
      requests: { cpu: '100m', memory: '512Mi' }
      limits: { memory: '1Gi' }
    }
    rabbitmq: {
      additionalPlugins: [ 'rabbitmq_auth_backend_oauth2' ]
      additionalConfig: additionalConfig
    }
    // The administrator the platform created, rather than one the operator generates.
    secretBackend: {
      externalSecret: {
        name: adminCredentialsSecretName
      }
    }
    // One node per worker where there are enough of them.
    affinity: {
      podAntiAffinity: {
        preferredDuringSchedulingIgnoredDuringExecution: [
          {
            weight: 100
            podAffinityTerm: {
              topologyKey: 'kubernetes.io/hostname'
              labelSelector: {
                matchLabels: {
                  'app.kubernetes.io/name': uniqueName
                }
              }
            }
          }
        ]
      }
    }
    override: {
      statefulSet: {
        spec: {
          template: podOverride
        }
      }
    }
  },
  empty(imagePullSecretName) ? {} : { imagePullSecrets: [ { name: imagePullSecretName } ] },
  useTls ? {
    tls: {
      secretName: tlsSecretName
      // AMQP, management and metrics over TLS only.
      disableNonTLSListeners: true
      interNode: {
        enabled: true
        issuerRef: {
          kind: 'ClusterIssuer'
          name: certificateIssuer
        }
      }
    }
  } : {})
}

// The operator creates no disruption budget. A quorum queue needs a majority of its nodes, so a
// drain or node upgrade may take only one at a time.
resource disruptionBudget 'policy/PodDisruptionBudget@v1' = if (replicas > 1) {
  metadata: {
    name: uniqueName
  }
  spec: {
    // Kubernetes IntOrString: a count must be an integer, so the Bicep type warning is a false positive.
    #disable-next-line BCP036
    maxUnavailable: 1
    selector: {
      matchLabels: {
        'app.kubernetes.io/name': uniqueName
      }
    }
  }
}

// The topology resources name the cluster; each depends on it, so it exists before them.
var clusterReference = {
  name: uniqueName
}

// The queue and its dead-letter queue, as Service Bus has, both quorum queues.
#disable-next-line BCP081
resource queue 'rabbitmq.com/Queue@v1beta1' = {
  dependsOn: [ rabbitmq ]
  metadata: {
    name: '${uniqueName}-queue'
  }
  spec: {
    name: queueName
    vhost: '/'
    type: 'quorum'
    durable: true
    autoDelete: false
    rabbitmqClusterReference: clusterReference
  }
}

#disable-next-line BCP081
resource deadLetterQueue 'rabbitmq.com/Queue@v1beta1' = {
  dependsOn: [ rabbitmq ]
  metadata: {
    name: '${uniqueName}-dead-letter'
  }
  spec: {
    name: deadLetterQueueName
    vhost: '/'
    type: 'quorum'
    durable: true
    autoDelete: false
    rabbitmqClusterReference: clusterReference
  }
}

// Moves a message to the dead-letter queue when the consumer rejects it without requeueing, or on its
// maxDeliveryCount-th delivery after the earlier ones ended with the consumer crashing. A policy
// rather than queue arguments, so a changed maxDeliveryCount applies to the existing queue.
#disable-next-line BCP081
resource deadLetterPolicy 'rabbitmq.com/Policy@v1beta1' = {
  dependsOn: [ rabbitmq ]
  metadata: {
    name: '${uniqueName}-dead-letter-policy'
  }
  spec: {
    name: '${queueName}-dead-letter'
    vhost: '/'
    pattern: '^${queueNamePattern}$'
    applyTo: 'quorum_queues'
    priority: 0
    definition: {
      'dead-letter-exchange': ''
      'dead-letter-routing-key': deadLetterQueueName
      'delivery-limit': deliveryLimit
    }
    rabbitmqClusterReference: clusterReference
  }
}

output result object = {
  // The operator's StatefulSet, Services and volumes belong to the RabbitmqCluster, so deleting it
  // removes them. cert-manager leaves the certificate's Secret behind when the Certificate is
  // deleted, so it is listed too, and the private key goes with the resource.
  resources: concat([
    '/planes/kubernetes/local/namespaces/${namespace}/providers/rabbitmq.com/RabbitmqCluster/${uniqueName}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/rabbitmq.com/Queue/${queue.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/rabbitmq.com/Queue/${deadLetterQueue.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/rabbitmq.com/Policy/${deadLetterPolicy.metadata.name}'
  ], replicas > 1 ? [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/policy/PodDisruptionBudget/${uniqueName}'
  ] : [], useTls ? [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/cert-manager.io/Certificate/${tlsSecretName}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${tlsSecretName}'
  ] : [])
  // No credentials: workloads authenticate with their own identity.
  values: {
    provider: 'rabbitmq'
    queueName: queueName
    // The operator's client Service, named after the cluster, balances across the nodes.
    endpoint: '${uniqueName}.${namespace}.svc.cluster.local:${amqpPort}'
    // The application verifies the certificate against the CAs the platform gives it.
    tls: useTls ? 'required' : 'optional'
    // Deliveries of a message before it is dead-lettered, as on Service Bus.
    maxDeliveryCount: maxDeliveryCount
  }
}
