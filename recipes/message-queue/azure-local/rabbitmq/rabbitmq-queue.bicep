// Recipe: Portability.Messaging/messageQueues -> RabbitMQ container in the cluster.
//
// Used by the Azure Local environment, where the workload must not depend on Azure Service Bus.
// Publishes provider = 'rabbitmq' so the application can select its RabbitMQ client at startup.
// The broker's data, including queued messages, lives on a persistent volume, so it survives the pod
// being replaced.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Tag of the rabbitmq container image to deploy.')
param tag string = '4-management-alpine'

@description('''
Registry serving the RabbitMQ image. Empty means Docker Hub. On Azure Local this is the in-cluster
connected registry, so a restarted pod still finds its image while the link to Azure is down.
''')
param imageRegistry string = ''

@description('Repository holding the RabbitMQ image within the registry.')
param imageRepository string = 'rabbitmq'

@description('''
Name of an existing Kubernetes image pull secret in the application namespace. Required when the
registry needs authentication: kubelet pulls this image, and it uses neither the Radius control
plane's registry credentials nor the application's own pull secret.
''')
param imagePullSecretName string = ''

@description('Username for the RabbitMQ broker.')
param username string = 'app'

@description('''
Issuer URL of the identity provider, for example `https://keycloak.example/realms/my-realm`. Setting this turns on
the OAuth 2.0 backend, so workloads authenticate with a token instead of the generated password.
The password remains in place for the management interface.
''')
param oauthIssuer string = ''

@description('Audience the broker requires in a token. Must match the audience the issuer stamps.')
param oauthResourceServerId string = 'rabbitmq'

@description('Claim the broker reads permissions from, for identity providers such as Keycloak that cannot express them as scopes.')
param oauthScopesKey string = 'rabbitmq_scopes'

@description('Existing Secret holding the issuer certificate authority under the key `ca.crt`.')
param oauthCaSecretName string = ''

// How a workload obtains its token is not this Recipe's concern: the Recipe Pack gives every pod
// its identity (token file, client and token endpoint). This Recipe only configures the broker to
// accept tokens from the issuer.

@description('Size of the persistent volume holding the broker data.')
param storageSize string = '2Gi'

@description('Storage class of that volume. Empty uses the cluster default.')
param storageClassName string = ''
var image = empty(imageRegistry) ? '${imageRepository}:${tag}' : '${imageRegistry}/${imageRepository}:${tag}'


extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var uniqueName = 'rabbitmq-${uniqueString(context.resource.id)}'
var queueName = context.resource.properties.?queueName ?? context.resource.name
var amqpPort = 5672
var managementPort = 15672

// Deterministic per-resource password. Recreating the resource rotates it.
var password = uniqueString(context.resource.id, 'rabbitmq-password')

var oauthEnabled = !empty(oauthIssuer)
var configName = '${uniqueName}-config'
var maxDeliveryCount = context.resource.properties.?maxDeliveryCount ?? 10
var deadLetterQueueName = '${queueName}.dead-letter'

// The policy matches the queue by regular expression, and a queue name may contain any character,
// so every regular expression metacharacter is escaped. The backslash goes first, or it would
// escape the escapes.
var queueNamePattern = reduce(
  [ '\\', '.', '+', '*', '?', '(', ')', '[', ']', '{', '}', '^', '$', '|' ],
  queueName,
  (escaped, character) => replace(escaped, character, '\\${character}'))

// Mounting conf.d replaces the image's own, which is where console logging is turned on, so it is
// restored here or the broker's logs stop reaching kubectl. Queues are quorum queues by default,
// so the application's declaration, which names no type, matches the queue defined below.
var baseConf = join([
  'log.console = true'
  'default_queue_type = quorum'
  ''
], '\n')

// The internal backend stays second so the generated password still reaches the management UI
// after a token is rejected.
var oauthConf = join([
  'auth_backends.1 = rabbit_auth_backend_oauth2'
  'auth_backends.2 = internal'
  'auth_oauth2.resource_server_id = ${oauthResourceServerId}'
  'auth_oauth2.issuer = ${oauthIssuer}'
  'auth_oauth2.additional_scopes_key = ${oauthScopesKey}'
  'auth_oauth2.preferred_username_claims.1 = preferred_username'
  empty(oauthCaSecretName) ? '' : 'auth_oauth2.https.cacertfile = /etc/rabbitmq/oauth-ca/ca.crt'
  ''
], '\n')

// The queue and its dead-letter queue, as Service Bus has. The policy moves a message to the
// dead-letter queue when the consumer rejects it without requeueing, or after maxDeliveryCount
// deliveries that ended with the consumer crashing. A policy rather than queue arguments, so a
// changed maxDeliveryCount applies to the existing queue.
var definitions = {
  queues: [
    {
      name: queueName
      vhost: '/'
      durable: true
      auto_delete: false
      arguments: { 'x-queue-type': 'quorum' }
    }
    {
      name: deadLetterQueueName
      vhost: '/'
      durable: true
      auto_delete: false
      arguments: { 'x-queue-type': 'quorum' }
    }
  ]
  policies: [
    {
      vhost: '/'
      name: '${queueName}-dead-letter'
      pattern: '^${queueNamePattern}$'
      'apply-to': 'quorum_queues'
      priority: 0
      definition: {
        'dead-letter-exchange': ''
        'dead-letter-routing-key': deadLetterQueueName
        'delivery-limit': maxDeliveryCount
      }
    }
  ]
}

var configData = union(
  {
    '10-defaults.conf': baseConf
    'definitions.json': string(definitions)
  },
  oauthEnabled ? {
    '20-oauth.conf': oauthConf
    enabled_plugins: '[rabbitmq_management,rabbitmq_auth_backend_oauth2].'
  } : {}
)

resource config 'core/ConfigMap@v1' = {
  metadata: {
    name: configName
  }
  data: configData
}

// Definitions loaded at boot would stop the broker creating its default user, so they are
// imported once it is running instead. The pod only becomes ready, and so reachable through the
// Service, after this hook completes. It runs as the broker's user, and waits for the broker to
// write its Erlang cookie, which rabbitmqctl would otherwise create with the wrong owner.
// await_startup fails at once until the broker's runtime is up, so it is retried, for up to five
// minutes; a broker that never starts still fails the pod.
// Joined with '\n' rather than written as a multi-line string, which would keep the file's line
// endings: a checkout with CRLF endings would break the shell script.
var importDefinitions = join([
  'set -e'
  'until [ -s /var/lib/rabbitmq/.erlang.cookie ]; do sleep 1; done'
  'attempt=0'
  'until su-exec rabbitmq rabbitmqctl -q await_startup --timeout 600 >/dev/null 2>&1; do'
  '  attempt=$((attempt + 1))'
  '  if [ "$attempt" -ge 60 ]; then echo "RabbitMQ did not start" >&2; exit 1; fi'
  '  sleep 5'
  'done'
  'su-exec rabbitmq rabbitmqctl -q update_vhost_metadata / --default-queue-type quorum'
  'su-exec rabbitmq rabbitmqctl -q import_definitions /etc/rabbitmq/definitions/definitions.json'
], '\n')

var oauthEnv = oauthEnabled ? [
  {
    name: 'RABBITMQ_ENABLED_PLUGINS_FILE'
    value: '/etc/rabbitmq/plugins/enabled_plugins'
  }
] : []

var configMounts = concat(
  [
    {
      name: 'conf'
      mountPath: '/etc/rabbitmq/conf.d'
      readOnly: true
    }
    {
      name: 'definitions'
      mountPath: '/etc/rabbitmq/definitions'
      readOnly: true
    }
  ],
  oauthEnabled ? [
    {
      name: 'plugins'
      mountPath: '/etc/rabbitmq/plugins'
      readOnly: true
    }
  ] : [],
  oauthEnabled && !empty(oauthCaSecretName) ? [
    {
      name: 'oauth-ca'
      mountPath: '/etc/rabbitmq/oauth-ca'
      readOnly: true
    }
  ] : []
)

var configVolumes = concat(
  [
    {
      name: 'conf'
      configMap: {
        name: config.metadata.name
        items: concat(
          [ { key: '10-defaults.conf', path: '10-defaults.conf' } ],
          oauthEnabled ? [ { key: '20-oauth.conf', path: '20-oauth.conf' } ] : []
        )
      }
    }
    {
      name: 'definitions'
      configMap: {
        name: config.metadata.name
        items: [ { key: 'definitions.json', path: 'definitions.json' } ]
      }
    }
  ],
  oauthEnabled ? [
    {
      name: 'plugins'
      configMap: {
        name: config.metadata.name
        items: [ { key: 'enabled_plugins', path: 'enabled_plugins' } ]
      }
    }
  ] : [],
  oauthEnabled && !empty(oauthCaSecretName) ? [
    {
      name: 'oauth-ca'
      secret: {
        secretName: oauthCaSecretName
        items: [
          {
            key: 'ca.crt'
            path: 'ca.crt'
          }
        ]
      }
    }
  ] : []
)
resource data 'core/PersistentVolumeClaim@v1' = {
  metadata: {
    name: '${uniqueName}-data'
  }
  spec: union({
    accessModes: [ 'ReadWriteOnce' ]
    resources: {
      requests: {
        storage: storageSize
      }
    }
  }, empty(storageClassName) ? {} : { storageClassName: storageClassName })
}

var dataVolume = {
  name: 'data'
  persistentVolumeClaim: {
    claimName: data.metadata.name
  }
}

resource rabbitmq 'apps/StatefulSet@v1' = {
  metadata: {
    name: uniqueName
  }
  spec: {
    // A StatefulSet starts a replacement pod only once the old one has stopped, so two servers
    // never use the volume at once. A Deployment can overlap them when a pod is deleted or evicted.
    // The volume is the claim above rather than a volumeClaimTemplate, so Radius deletes it with the
    // resource.
    serviceName: svc.metadata.name
    selector: {
      matchLabels: {
        app: 'rabbitmq'
        resource: context.resource.name
      }
    }
    template: {
      metadata: {
        labels: {
          app: 'rabbitmq'
          resource: context.resource.name
          // Lets `rad run` locate the logs for this application.
          'radapp.io/application': context.application == null ? '' : context.application.name
        }
        // The configuration is read, and the definitions imported, only when the broker starts.
        // A change to it, such as a new maxDeliveryCount or queue name, changes this annotation,
        // so the pod restarts and picks it up.
        annotations: {
          'portability.radapp.io/config-hash': uniqueString(string(configData))
        }
      }
      spec: union(
        empty(imagePullSecretName) ? {} : { imagePullSecrets: [ { name: imagePullSecretName } ] },
        { volumes: concat([ dataVolume ], configVolumes) },
        {
        containers: [
          {
            name: 'rabbitmq'
            image: image
            ports: [
              {
                containerPort: amqpPort
              }
              {
                containerPort: managementPort
              }
            ]
            volumeMounts: concat([
              {
                name: 'data'
                mountPath: '/var/lib/rabbitmq'
              }
            ], configMounts)
            env: concat([
              // RabbitMQ keeps its data under its node name, which defaults to the pod's host name and
              // changes with every new pod. A fixed name lets a replacement pod find the data.
              {
                name: 'RABBITMQ_NODENAME'
                value: 'rabbit@localhost'
              }
              {
                name: 'RABBITMQ_DEFAULT_USER'
                value: username
              }
              {
                name: 'RABBITMQ_DEFAULT_PASS'
                value: password
              }
            ], oauthEnv)
            lifecycle: {
              postStart: {
                exec: {
                  command: [ 'sh', '-c', importDefinitions ]
                }
              }
            }
            resources: {
              requests: {
                cpu: '100m'
                memory: '256Mi'
              }
              limits: {
                memory: '512Mi'
              }
            }
            readinessProbe: {
              // `rabbitmq-diagnostics ping` starts a second Erlang node and takes several seconds,
              // which always exceeds the default 1s probe timeout and leaves the pod NotReady.
              // A TCP check on the AMQP port is cheap and is what actually matters to clients.
              tcpSocket: {
                #disable-next-line BCP036
                port: amqpPort
              }
              initialDelaySeconds: 20
              periodSeconds: 10
              failureThreshold: 12
            }
          }
        ]
        }
      )
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: uniqueName
    labels: {
      name: uniqueName
    }
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      app: 'rabbitmq'
      resource: context.resource.name
    }
    ports: [
      {
        name: 'amqp'
        port: amqpPort
        #disable-next-line BCP036
        targetPort: amqpPort
      }
      {
        name: 'management'
        port: managementPort
        #disable-next-line BCP036
        targetPort: managementPort
      }
    ]
  }
}

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${svc.metadata.namespace}/providers/core/Service/${svc.metadata.name}'
    '/planes/kubernetes/local/namespaces/${rabbitmq.metadata.namespace}/providers/apps/StatefulSet/${rabbitmq.metadata.name}'
    '/planes/kubernetes/local/namespaces/${data.metadata.namespace}/providers/core/PersistentVolumeClaim/${data.metadata.name}'
    '/planes/kubernetes/local/namespaces/${config.metadata.namespace}/providers/core/ConfigMap/${config.metadata.name}'
  ]
  values: {
    provider: 'rabbitmq'
    queueName: queueName
    endpoint: '${svc.metadata.name}.${svc.metadata.namespace}.svc.cluster.local:${amqpPort}'
  }
  // With OAuth the workloads authenticate with their own identity, so the broker password stays
  // with the broker (management interface only) and is not handed to the application.
  secrets: oauthEnabled ? {} : {
    username: username
    #disable-next-line outputs-should-not-contain-secrets
    password: password
  }
}
